<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Emergency Access Timer</title>
    <link
      href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />

    <style>
      .countdown-circle {
        transform: rotate(-90deg);
        width: 200px;
        height: 200px;
      }

      .countdown-circle-bg {
        fill: none;
        stroke: rgba(239, 68, 68, 0.2);
        stroke-width: 8;
      }

      .countdown-circle-progress {
        fill: none;
        stroke: #ef4444;
        stroke-width: 8;
        stroke-linecap: round;
        transition: stroke-dashoffset 1s linear;
      }

      .pulse-animation {
        animation: pulse 2s infinite;
      }

      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.05);
        }
      }

      .cancel-button {
        background: linear-gradient(45deg, #059669, #047857);
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(5, 150, 105, 0.3);
      }

      .cancel-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(5, 150, 105, 0.4);
      }

      .timer-container {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
      }
    </style>
  </head>
  <body class="bg-gray-900 min-h-screen flex items-center justify-center">
    <div class="timer-container rounded-xl shadow-2xl p-8 max-w-md w-full mx-4">
      <div class="text-center text-white">
        <!-- Warning Icon -->
        <div class="mb-6">
          <i
            class="fas fa-exclamation-triangle text-6xl text-yellow-300 pulse-animation"
          ></i>
        </div>

        <!-- Title -->
        <h1 class="text-3xl font-bold mb-4">Emergency Access Alert</h1>
        <p class="text-lg mb-6 text-red-100">
          Emergency contacts will be notified in:
        </p>

        <!-- Countdown Circle -->
        <div class="flex justify-center mb-6">
          <div class="relative">
            <svg class="countdown-circle">
              <circle
                class="countdown-circle-bg"
                cx="100"
                cy="100"
                r="80"
              ></circle>
              <circle
                id="countdown-progress"
                class="countdown-circle-progress"
                cx="100"
                cy="100"
                r="80"
                stroke-dasharray="502.4"
                stroke-dashoffset="0"
              ></circle>
            </svg>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-center">
                <div
                  id="countdown-number"
                  class="text-6xl font-bold text-white"
                >
                  10
                </div>
                <div class="text-sm text-red-100">seconds</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Patient Info -->
        <div class="bg-red-600 bg-opacity-50 rounded-lg p-4 mb-6">
          <p class="text-sm text-red-100 mb-1">
            <i class="fas fa-user-md mr-2"></i>
            Patient: <strong><%= patientName %></strong>
          </p>
          <p class="text-sm text-red-100">
            <i class="fas fa-id-card mr-2"></i>
            Token: <strong><%= tokenId.substring(0, 8) %>...</strong>
          </p>
        </div>

        <!-- Cancel Button -->
        <button
          id="cancel-btn"
          onclick="cancelTimer()"
          class="cancel-button text-white font-bold py-4 px-8 rounded-lg flex items-center justify-center space-x-3 transition-all duration-300 w-full text-xl"
        >
          <i class="fas fa-times-circle text-2xl"></i>
          <span>CANCEL ALERT</span>
        </button>

        <!-- Info Text -->
        <p class="text-xs text-red-200 mt-4 leading-relaxed">
          <i class="fas fa-info-circle mr-1"></i>
          Click "Cancel Alert" to prevent emergency notifications. If no action
          is taken, emergency contacts will be automatically notified with
          location and device information.
        </p>
      </div>
    </div>

    <script>
      // Global variables
      const TOKEN_ID = "<%= tokenId %>";
      const PATIENT_NAME = "<%= patientName %>";
      const COUNTDOWN_DURATION = 10; // seconds

      let timeRemaining = COUNTDOWN_DURATION;
      let countdownInterval;
      let timerCancelled = false;

      // API Configuration
      const getApiServerUrl = () => {
        const hostname = window.location.hostname;
        const isDevelopment =
          hostname === "localhost" ||
          hostname === "127.0.0.1" ||
          hostname.startsWith("192.168.") ||
          hostname.startsWith("10.");

        if (isDevelopment) {
          if (hostname.startsWith("192.168.") || hostname.startsWith("10.")) {
            return `http://${hostname}:5000`;
          } else {
            return "http://localhost:5000";
          }
        } else {
          return window.location.origin;
        }
      };

      const API_CONFIG = {
        baseURL: getApiServerUrl(),
      };

      /**
       * Start the countdown timer
       */
      function startCountdown() {
        const countdownNumber = document.getElementById("countdown-number");
        const countdownProgress = document.getElementById("countdown-progress");
        const cancelBtn = document.getElementById("cancel-btn");

        const circumference = 2 * Math.PI * 80; // radius = 80

        function updateCountdown() {
          if (timerCancelled) {
            clearInterval(countdownInterval);
            return;
          }

          // Update number display
          countdownNumber.textContent = timeRemaining;

          // Update progress circle
          const progress =
            (COUNTDOWN_DURATION - timeRemaining) / COUNTDOWN_DURATION;
          const offset = circumference * progress;
          countdownProgress.style.strokeDashoffset = offset;

          // Change colors as time runs out
          if (timeRemaining <= 3) {
            countdownNumber.className =
              "text-6xl font-bold text-yellow-300 pulse-animation";
            countdownProgress.style.stroke = "#fbbf24";
          } else if (timeRemaining <= 5) {
            countdownNumber.className = "text-6xl font-bold text-orange-300";
            countdownProgress.style.stroke = "#fb923c";
          }

          timeRemaining--;

          // Timer expired - trigger emergency alert
          if (timeRemaining < 0) {
            clearInterval(countdownInterval);
            triggerEmergencyAlert();
          }
        }

        // Update immediately
        updateCountdown();

        // Start interval
        countdownInterval = setInterval(updateCountdown, 1000);
      }

      /**
       * Cancel the timer and redirect to patient data
       */
      async function cancelTimer() {
        if (timerCancelled) return;

        timerCancelled = true;
        clearInterval(countdownInterval);

        const cancelBtn = document.getElementById("cancel-btn");

        // Update button to show cancelling state
        cancelBtn.disabled = true;
        cancelBtn.innerHTML = `
          <i class="fas fa-spinner fa-spin text-2xl"></i>
          <span>CANCELLING...</span>
        `;

        try {
          console.log("🚫 Timer cancelled by user");

          // No server call needed for cancellation - just redirect
          console.log("✅ Timer cancelled successfully");

          // Update UI to show success
          cancelBtn.innerHTML = `
            <i class="fas fa-check-circle text-2xl"></i>
            <span>CANCELLED</span>
          `;

          // Redirect to patient data after short delay
          setTimeout(() => {
            window.location.href = `${API_CONFIG.baseURL}/patients/patient-data-after-timer/${TOKEN_ID}?cancelled=true`;
          }, 1000);
        } catch (error) {
          console.error("❌ Error cancelling timer:", error);

          // Show error state but still redirect
          cancelBtn.innerHTML = `
            <i class="fas fa-exclamation-triangle text-2xl"></i>
            <span>ERROR - REDIRECTING</span>
          `;

          setTimeout(() => {
            window.location.href = `${API_CONFIG.baseURL}/patients/patient-data-after-timer/${TOKEN_ID}?cancelled=true`;
          }, 2000);
        }
      }

      /**
       * Timer expired - trigger automatic emergency alert
       */
      async function triggerEmergencyAlert() {
        const countdownNumber = document.getElementById("countdown-number");
        const cancelBtn = document.getElementById("cancel-btn");

        // Update UI to show alert is being sent
        countdownNumber.textContent = "0";
        countdownNumber.className =
          "text-6xl font-bold text-red-300 pulse-animation";

        cancelBtn.disabled = true;
        cancelBtn.innerHTML = `
          <i class="fas fa-paper-plane text-2xl"></i>
          <span>SENDING ALERT...</span>
        `;

        try {
          console.log(
            "🚨 Timer expired - triggering automatic emergency alert"
          );

          // Get device and location info
          const deviceInfo = {
            userAgent: navigator.userAgent,
            deviceName: getDeviceName(),
            browserName: getBrowserName(),
            osName: getOSName(),
            deviceType: getDeviceType(),
            timestamp: new Date().toISOString(),
          };

          // Call timer expiration endpoint
          const response = await fetch(
            `${API_CONFIG.baseURL}/patients/timer-expired/${TOKEN_ID}`,
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                patientName: PATIENT_NAME,
                deviceInfo: deviceInfo,
                locationData: null, // Will be handled by server
                timerExpired: true,
                timerDuration: COUNTDOWN_DURATION,
                completedAt: new Date().toISOString(),
              }),
            }
          );

          if (response.ok) {
            const result = await response.json();
            console.log("✅ Automatic emergency alert sent:", result);

            // Update UI to show success
            cancelBtn.innerHTML = `
              <i class="fas fa-check-circle text-2xl"></i>
              <span>ALERT SENT</span>
            `;

            // Redirect to patient data after short delay (no alert popup)
            setTimeout(() => {
              console.log(
                `Emergency contacts notified successfully. ${
                  result.contactCount || 0
                } contacts alerted.`
              );
              window.location.href = `${API_CONFIG.baseURL}/patients/patient-data-after-timer/${TOKEN_ID}?cancelled=false`;
            }, 1500);
          } else {
            throw new Error("Emergency alert failed");
          }
        } catch (error) {
          console.error("❌ Error sending emergency alert:", error);

          // Update UI to show error
          cancelBtn.innerHTML = `
            <i class="fas fa-exclamation-triangle text-2xl"></i>
            <span>ALERT ERROR</span>
          `;

          // Redirect after error (no alert popup)
          setTimeout(() => {
            console.error(
              "Error sending emergency alert. Please contact emergency services directly if needed."
            );
            window.location.href = `${API_CONFIG.baseURL}/patients/patient-data-after-timer/${TOKEN_ID}?cancelled=false`;
          }, 2000);
        }
      }

      // Helper functions for device detection
      function getDeviceName() {
        const ua = navigator.userAgent;
        if (/iPhone/i.test(ua)) return "iPhone";
        if (/iPad/i.test(ua)) return "iPad";
        if (/Android/i.test(ua)) return "Android Device";
        if (/Mac/i.test(ua)) return "Mac";
        if (/Windows/i.test(ua)) return "Windows PC";
        return "Unknown Device";
      }

      function getBrowserName() {
        const ua = navigator.userAgent;
        if (/Safari/i.test(ua) && !/Chrome/i.test(ua)) return "Safari";
        if (/Chrome/i.test(ua)) return "Chrome";
        if (/Firefox/i.test(ua)) return "Firefox";
        if (/Edge/i.test(ua)) return "Edge";
        return "Unknown Browser";
      }

      function getOSName() {
        const ua = navigator.userAgent;
        if (/iPhone|iPad/i.test(ua)) return "iOS";
        if (/Android/i.test(ua)) return "Android";
        if (/Mac OS X/i.test(ua)) return "macOS";
        if (/Windows/i.test(ua)) return "Windows";
        return "Unknown OS";
      }

      function getDeviceType() {
        return /iPhone|iPad|iPod|Android/i.test(navigator.userAgent)
          ? "mobile"
          : "desktop";
      }

      // Start countdown when page loads
      document.addEventListener("DOMContentLoaded", function () {
        console.log("⏰ Emergency access timer started");
        startCountdown();
      });

      // ✅ REMOVED: beforeunload event listener that showed confirmation dialog
      // No more prompts when user tries to leave the page
    </script>
  </body>
</html>
