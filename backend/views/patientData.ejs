            /**
             * Load Local Script (Desktop)
             */
            async function loadLocalScript(scriptUrl) {
              return new Promise((resolve, reject) => {
                if (window.fingerprintService && window.FingerprintJSBrowser) {
                  console.log("✅ Local service already available");
                  resolve();
                  return;
                }

                const script = document.createElement("script");
                script.src = scriptUrl;
                script.async = true;

                const timeoutId = setTimeout(() => {
                  script.remove();
                  reject(new Error("Local script loading timeout"));
                }, 8000);

                script.onload = () => {
                  clearTimeout(timeoutId);
                  console.log("✅ Local script loaded successfully");

                  let attempts = 0;
                  const checkService = () => {
                    attempts++;
                    if (window.fingerprintService && window.FingerprintJSBrowser) {
                      resolve();
                    } else if (attempts < 20) {
                      setTimeout(checkService, 100);
                    } else {
                      reject(
                        new Error("Local service not available after script load")
                      );
                    }
                  };
                  checkService();
                };

                script.onerror = () => {
                  clearTimeout(timeoutId);
                  reject(new Error("Local script loading failed"));
                };

                document.head.appendChild(script);
              });
            }

