<!-- views/patientData.ejs -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />
  </head>
  <body class="bg-gray-100 min-h-screen">
    <div class="container mx-auto px-4 py-6 max-w-6xl">
      <!-- Emergency Access Banner -->
      <% if (typeof isEmergencyAccess !== 'undefined' && isEmergencyAccess) { %>
      <div
        class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded-r-lg shadow-sm"
      >
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <i
              class="fas fa-exclamation-triangle text-red-500 text-xl mr-3"
            ></i>
            <div>
              <p class="font-semibold text-lg">Emergency Access Mode</p>
              <p class="text-sm">
                Patient medical data accessed via SmartToken • Access Time:
                <span id="access-time-display"
                  ><%= new Date(accessTime).toLocaleString() %>
                </span>
              </p>
            </div>
          </div>
          <!-- Session Timer -->
          <div class="text-right">
            <p class="text-sm font-medium">Session expires in:</p>
            <p id="session-timer" class="text-lg font-bold text-red-600">
              5:00
            </p>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Offline Mode Warning -->
      <% if (typeof isOfflineMode !== 'undefined' && isOfflineMode) { %>
      <div
        class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4 mb-6 rounded-r-lg shadow-sm"
      >
        <div class="flex items-center">
          <i class="fas fa-wifi text-yellow-500 text-xl mr-3"></i>
          <div>
            <p class="font-semibold">Limited Access Mode</p>
            <p class="text-sm"><%= warning %></p>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Patient Header -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold text-gray-800 mb-2">
              <i class="fas fa-user-injured text-blue-600 mr-3"></i>
              <%= patientName %>
            </h1>
            <div class="text-gray-600">
              <span
                class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium mr-2"
              >
                <i class="fas fa-folder mr-1"></i>
                Container: <%= containerName %>
              </span>
              <span
                class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-medium"
              >
                <i class="fas fa-file-medical mr-1"></i>
                Folder: <%= folderName %>
              </span>
            </div>
          </div>
          <div class="text-right text-gray-500">
            <p class="text-sm">Token ID: <%= tokenId.substring(0, 8) %>...</p>
            <p class="text-sm">Compass Point Health PRMS</p>
          </div>
        </div>
      </div>

      <!-- Patient Files Section -->
      <div
        id="patient-content"
        class="bg-white rounded-lg shadow-md overflow-hidden"
      >
        <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
          <h2 class="text-xl font-semibold text-gray-800 flex items-center">
            <i class="fas fa-file-medical-alt text-green-600 mr-2"></i>
            Patient Medical Files <% if (files && files.length > 0) { %>
            <span
              class="ml-2 bg-blue-500 text-white px-2 py-1 rounded-full text-sm"
            >
              <%= files.length %> files
            </span>
            <% } %>
          </h2>
        </div>

        <div class="p-6">
          <% if (!files || files.length === 0) { %>
          <div class="text-center py-12">
            <i class="fas fa-folder-open text-gray-400 text-6xl mb-4"></i>
            <p class="text-gray-600 text-lg">
              No medical files found for this patient
            </p>
            <p class="text-gray-500 text-sm mt-2">
              Files may be stored in a different location or not yet uploaded
            </p>
          </div>
          <% } else { %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                  >
                    <i class="fas fa-file mr-1"></i>File Name
                  </th>
                  <th
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                  >
                    <i class="fas fa-tags mr-1"></i>Type
                  </th>
                  <th
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                  >
                    <i class="fas fa-weight mr-1"></i>Size
                  </th>
                  <th
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                  >
                    <i class="fas fa-clock mr-1"></i>Last Modified
                  </th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% files.forEach(function(file, index) { %>
                <tr class="hover:bg-gray-50 transition-colors duration-200">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                      <% let fileIcon = 'fa-file'; if (file.contentType) { if
                      (file.contentType.includes('image')) { fileIcon =
                      'fa-file-image text-green-500'; } else if
                      (file.contentType.includes('pdf')) { fileIcon =
                      'fa-file-pdf text-red-500'; } else if
                      (file.contentType.includes('word')) { fileIcon =
                      'fa-file-word text-blue-500'; } else if
                      (file.contentType.includes('excel')) { fileIcon =
                      'fa-file-excel text-green-600'; } } %>
                      <i class="fas <%= fileIcon %> mr-3 text-lg"></i>
                      <div>
                        <% if (file.sasUrl) { %>
                        <!-- Make file name clickable with SAS URL -->
                        <a
                          href="<%= file.sasUrl %>"
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-sm font-medium text-blue-600 hover:text-blue-800 hover:underline cursor-pointer file-link"
                          title="Click to open file"
                        >
                          <%= file.name %>
                        </a>
                        <% } else { %>
                        <!-- Fallback clickable file name -->
                        <a
                          href="/patients/file/<%= containerName %>/<%= folderName %>/<%= encodeURIComponent(file.name) %>"
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-sm font-medium text-blue-600 hover:text-blue-800 hover:underline cursor-pointer file-link"
                          title="Click to open file"
                        >
                          <%= file.name %>
                        </a>
                        <% } %>
                        <p class="text-xs text-gray-500">
                          <%= file.fullPath %>
                        </p>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <span
                      class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800"
                    >
                      <%= file.contentType || 'Unknown' %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <% function formatFileSize(bytes) { if (bytes === 0) return
                    "0 Bytes"; const k = 1024; const sizes = ["Bytes", "KB",
                    "MB", "GB"]; const i = Math.floor(Math.log(bytes) /
                    Math.log(k)); return parseFloat((bytes / Math.pow(k,
                    i)).toFixed(2)) + " " + sizes[i]; } %> <%=
                    formatFileSize(file.contentLength) %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= new Date(file.lastModified).toLocaleString() %>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Session Expired Modal (Hidden by default) -->
      <div
        id="expired-modal"
        class="fixed inset-0 z-50 hidden overflow-y-auto bg-black bg-opacity-75"
      >
        <div
          class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center"
        >
          <div
            class="bg-white rounded-lg shadow-xl transform transition-all max-w-md w-full p-8"
          >
            <div
              class="w-16 h-16 mx-auto mb-4 bg-red-100 rounded-full flex items-center justify-center"
            >
              <i class="fas fa-clock text-red-600 text-2xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-gray-800 mb-4">
              Session Expired
            </h2>
            <p class="text-gray-600 mb-6">
              Your emergency access session has expired for security reasons.
              Please scan the SmartToken again to access patient data.
            </p>
            <div class="bg-red-50 rounded-lg p-4 mb-6">
              <p class="text-sm text-red-800">
                <i class="fas fa-shield-alt mr-2"></i>
                Emergency access sessions are limited to 5 minutes for patient
                privacy and security.
              </p>
            </div>
            <button
              onclick="window.close()"
              class="bg-red-500 hover:bg-red-600 text-white px-6 py-2 rounded-md transition-colors duration-200"
            >
              Close Window
            </button>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="mt-8 text-center text-gray-500 text-sm">
        <p>
          <i class="fas fa-shield-alt mr-1"></i>
          Secure Emergency Access • CompassPoint Health Patient Records
          Management System
        </p>
        <p class="mt-1">
          For assistance, contact emergency medical services or the facility
          administrator
        </p>
      </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        // Display access time in user's local timezone
        function displayLocalAccessTime() {
          const accessTimeElement = document.getElementById(
            "access-time-display"
          );
          if (accessTimeElement) {
            const accessTime = new Date("<%= accessTime %>");

            // Get user's timezone name
            const userTimezone =
              Intl.DateTimeFormat().resolvedOptions().timeZone;

            // Format time in user's local timezone
            const localTimeString = accessTime.toLocaleString(undefined, {
              year: "numeric",
              month: "2-digit",
              day: "2-digit",
              hour: "2-digit",
              minute: "2-digit",
              second: "2-digit",
              hour12: true,
              timeZoneName: "short",
            });

            accessTimeElement.textContent = localTimeString;

            // Log timezone info for debugging
            console.log("User timezone:", userTimezone);
            console.log("Local access time:", localTimeString);
          }
        }

        // Set session duration to 5 minutes (300 seconds)
        const SESSION_DURATION = 5 * 60; // 5 minutes in seconds
        let timeRemaining = SESSION_DURATION;
        let sessionTimer = null;
        let isExpired = false;

        // Get DOM elements
        const timerElement = document.getElementById("session-timer");
        const expiredModal = document.getElementById("expired-modal");
        const patientContent = document.getElementById("patient-content");
        const fileLinks = document.querySelectorAll(".file-link");

        // Format time as MM:SS
        function formatTime(seconds) {
          const minutes = Math.floor(seconds / 60);
          const remainingSeconds = seconds % 60;
          return `${minutes}:${remainingSeconds.toString().padStart(2, "0")}`;
        }

        // Update timer display
        function updateTimer() {
          if (timerElement) {
            timerElement.textContent = formatTime(timeRemaining);

            // Change color based on time remaining
            if (timeRemaining <= 60) {
              // Last minute - red
              timerElement.className =
                "text-lg font-bold text-red-600 animate-pulse";
            } else if (timeRemaining <= 120) {
              // Last 2 minutes - orange
              timerElement.className = "text-lg font-bold text-orange-600";
            } else {
              timerElement.className = "text-lg font-bold text-red-600";
            }
          }
        }

        // Expire session
        function expireSession() {
          isExpired = true;

          // Clear the timer
          if (sessionTimer) {
            clearInterval(sessionTimer);
          }

          // Disable all file links
          fileLinks.forEach((link) => {
            link.classList.add("opacity-50", "cursor-not-allowed");
            link.setAttribute("disabled", "true");
            link.onclick = function (e) {
              e.preventDefault();
              return false;
            };
          });

          // Show expired modal
          if (expiredModal) {
            expiredModal.classList.remove("hidden");
          }

          // Optionally blur/disable content
          if (patientContent) {
            patientContent.classList.add("opacity-50");
          }

          console.log("Emergency access session has expired");
        }

        // Start the session timer
        function startSessionTimer() {
          updateTimer(); // Initial update

          sessionTimer = setInterval(() => {
            timeRemaining--;
            updateTimer();

            // Check if session expired
            if (timeRemaining <= 0 && !isExpired) {
              expireSession();
            }
          }, 1000);
        }

        // Warning at 1 minute remaining
        function showWarning() {
          // You could add a warning notification here if desired
          console.log("Warning: Session expires in 1 minute");
        }

        // Display local access time
        displayLocalAccessTime();

        // Start the timer when page loads
        startSessionTimer();

        // Show warning at 1 minute remaining
        setTimeout(showWarning, (SESSION_DURATION - 60) * 1000);

        // Prevent page refresh/navigation after expiry
        window.addEventListener("beforeunload", function (e) {
          if (isExpired) {
            e.preventDefault();
            e.returnValue =
              "Your session has expired. Please scan the SmartToken again.";
          }
        });

        console.log(
          "Patient data page loaded - 5 minute session timer started with clickable file names"
        );
      });
    </script>
  </body>
</html>
