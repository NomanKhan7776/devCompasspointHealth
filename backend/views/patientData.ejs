            const alertBtn = document.getElementById("emergency-alert-btn");
            alertBtn.disabled = false;
            alertBtn.classList.remove("alert-sending");
            alertBtn.innerHTML = `
              <i class="fas fa-exclamation-triangle text-xl"></i>
              <span class="text-lg">SEND EMERGENCY ALERT</span>
            `;
          }, 2000);
        }
      }

      /**
       * Close alert modal
       */
      function closeAlertModal() {
        const alertModal = document.getElementById("alert-status-modal");
        alertModal.classList.add("hidden");
      }

      // Helper functions
      function getDeviceName() {
        const ua = navigator.userAgent;
        if (/iPhone/i.test(ua)) return "iPhone";
        if (/iPad/i.test(ua)) return "iPad";
        if (/Android/i.test(ua)) return "Android Device";
        if (/Mac/i.test(ua)) return "Mac";
        if (/Windows/i.test(ua)) return "Windows PC";
        return "Unknown Device";
      }

      function getBrowserName() {
        const ua = navigator.userAgent;
        if (/Safari/i.test(ua) && !/Chrome/i.test(ua)) return "Safari";
        if (/Chrome/i.test(ua)) return "Chrome";
        if (/Firefox/i.test(ua)) return "Firefox";
        if (/Edge/i.test(ua)) return "Edge";
        return "Unknown Browser";
      }

      function getOSName() {
        const ua = navigator.userAgent;
        if (/iPhone|iPad/i.test(ua)) return "iOS";
        if (/Android/i.test(ua)) return "Android";
        if (/Mac OS X/i.test(ua)) return "macOS";
        if (/Windows/i.test(ua)) return "Windows";
        return "Unknown OS";
      }

      function getDeviceType() {
        return /iPhone|iPad|iPod|Android/i.test(navigator.userAgent)
          ? "mobile"
          : "desktop";
      }

      function loadProfileImage() {
        const profileImageContainer = document.getElementById(
          "profile-image-container"
        );
        const profileImageUrl = `${API_CONFIG.baseURL}/api/blobs/${CONTAINER_NAME}/${FOLDER_NAME}/profile-image`;

        const img = document.createElement("img");
        img.className = "profile-image";
        img.alt = `${PATIENT_NAME} - Profile Photo`;

        img.onload = function () {
          profileImageContainer.innerHTML = "";
          profileImageContainer.appendChild(img);
        };

        img.onerror = function () {
          // Keep the initials placeholder
        };

        img.src = profileImageUrl;
      }

      function startSessionTimer() {
        const SESSION_DURATION = 5 * 60;
        let timeRemaining = SESSION_DURATION;
        const timerElement = document.getElementById("session-timer");

        function formatTime(seconds) {
          const minutes = Math.floor(seconds / 60);
          const remainingSeconds = seconds % 60;
          return `${minutes}:${remainingSeconds.toString().padStart(2, "0")}`;
        }

        function updateTimer() {
          if (timerElement) {
            timerElement.textContent = formatTime(timeRemaining);

            if (timeRemaining <= 60) {
              timerElement.className =
                "text-2xl font-bold animate-pulse text-red-200";
            } else if (timeRemaining <= 120) {
              timerElement.className = "text-2xl font-bold text-yellow-200";
            }
          }
        }

        updateTimer();
        const sessionTimer = setInterval(() => {
          timeRemaining--;
          updateTimer();
          if (timeRemaining <= 0) {
            clearInterval(sessionTimer);
            window.isExpired = true;
            const expiredModal = document.getElementById("expired-modal");
            if (expiredModal) {
              expiredModal.classList.remove("hidden");
            }
          }
        }, 1000);
      }

      function setupFileLinks() {
        const fileButtons = document.querySelectorAll(
          ".file-link[data-container]"
        );
        fileButtons.forEach((button) => {
          button.addEventListener("click", function (e) {
            e.preventDefault();

            if (window.isExpired) {
              alert("Session has expired. Please scan the SmartToken again.");
              return;
            }

            const container = this.getAttribute("data-container");
            const folder = this.getAttribute("data-folder");
            const filename = this.getAttribute("data-filename");

            viewFile(container, folder, filename);
          });
        });
      }

      function viewFile(containerName, folderName, fileName) {
        const viewUrl = `${API_CONFIG.baseURL}/patients/file/${containerName}/${folderName}/${fileName}/view`;

        const isIOSSafari =
          /iPhone|iPad|iPod/i.test(navigator.userAgent) &&
          /Safari/i.test(navigator.userAgent) &&
          !/Chrome/i.test(navigator.userAgent);

        if (isIOSSafari) {
          window.location.href = viewUrl;
        } else {
          const newWindow = window.open(viewUrl, "_blank");
          if (!newWindow || newWindow.closed) {
            window.location.href = viewUrl;
          }
        }
      }

      function closeExpiredModal() {
        try {
          window.close();
        } catch (e) {
          window.history.back();
        }
      }

      // ENHANCED: Initialize everything with FingerprintJS Pro location
      document.addEventListener("DOMContentLoaded", async function () {
        console.log(
          "🚀 Initializing SmartToken page with enhanced security verification + Location..."
        );

        // Load profile image
        loadProfileImage();

        // Start location detection immediately
        console.log("🌍 Starting location detection process...");
        updateLocationDisplay(); // Show initial loading state

        // Get GPS location first (non-blocking)
        getGPSLocation().then((gpsLocation) => {
          if (gpsLocation) {
            locationData.gps = gpsLocation;
            locationData.hasGPS = true;
            console.log("✅ GPS location obtained");
            updateLocationDisplay();
          }
        });

        // Start session timer
        startSessionTimer();

        // Setup file links
        setupFileLinks();

        // Display access time
        const accessTimeElement = document.getElementById(
          "access-time-display"
        );
        if (accessTimeElement) {
          try {
            const accessTime = new Date("<%= accessTime %>");
            const localTimeString = accessTime.toLocaleString(undefined, {
              month: "short",
              day: "numeric",
              hour: "2-digit",
              minute: "2-digit",
              hour12: true,
            });
            accessTimeElement.textContent = `Access granted at ${localTimeString}`;
          } catch (error) {
            accessTimeElement.textContent = "Emergency access active";
          }
        }

        // iOS Safari optimizations
        const isIOSSafari =
          /iPhone|iPad|iPod/i.test(navigator.userAgent) &&
          /Safari/i.test(navigator.userAgent) &&
          !/Chrome/i.test(navigator.userAgent);

        if (isIOSSafari) {
          const notice = document.getElementById("safari-ios-notice");
          if (notice) {
            notice.style.display = "block";
          }
        }

        // Initialize enhanced device verification (this will also get IP location)
        console.log(
          "📱 Starting enhanced security verification initialization with location..."
        );

        try {
          await initFingerprintJS();
        } catch (error) {
          console.error(
            "❌ Critical error during enhanced security verification initialization:",
            error
          );
        }
      });
    </script>
  </body>
</html>
