<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />
    <!-- Device Fingerprinting Service -->
    <script>
      // Dynamic script loading for mobile
      const hostname = window.location.hostname;
      let scriptUrl;

      if (hostname.startsWith("192.168.") || hostname.startsWith("10.")) {
        // Mobile device - use same IP as current page
        scriptUrl = `http://${hostname}:5000/js/deviceFingerprintingService.js`;
      } else if (hostname === "localhost" || hostname === "127.0.0.1") {
        // Desktop browser
        scriptUrl = "http://localhost:5000/js/deviceFingerprintingService.js";
      } else {
        // Production
        scriptUrl = `${window.location.origin}/js/deviceFingerprintingService.js`;
      }

      console.log("Loading fingerprinting service from:", scriptUrl);

      const script = document.createElement("script");
      script.src = scriptUrl;
      script.onload = () => console.log("Fingerprinting service loaded");
      script.onerror = () =>
        console.error("Failed to load fingerprinting service");
      document.head.appendChild(script);
    </script>

    <style>
      .profile-image {
        width: 150px;
        height: 150px;
        border-radius: 12px;
        object-fit: cover;
        border: 3px solid #e5e7eb;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      }
      .profile-placeholder {
        width: 150px;
        height: 150px;
        border-radius: 12px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 3px solid #e5e7eb;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      }
      .profile-initials {
        font-size: 3rem;
        font-weight: bold;
        color: white;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
      }
      .location-badge {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255, 255, 255, 0.2);
      }

      .location-icon {
        animation: pulse 2s infinite;
      }

      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.05);
        }
      }

      .access-location {
        background: linear-gradient(
          45deg,
          rgba(255, 255, 255, 0.1),
          rgba(255, 255, 255, 0.05)
        );
        border-left: 4px solid rgba(255, 255, 255, 0.3);
      }

      .location-loading {
        display: inline-block;
        width: 20px;
        height: 20px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        border-top-color: #fff;
        animation: spin 1s ease-in-out infinite;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      @media (max-width: 640px) {
        .profile-image,
        .profile-placeholder {
          width: 120px;
          height: 120px;
        }
        .profile-initials {
          font-size: 2.5rem;
        }
      }
    </style>
  </head>
  <body class="bg-gray-100 min-h-screen">
    <div class="container mx-auto px-4 py-6 max-w-4xl">
      <!-- Emergency Access Banner -->
      <% if (typeof isEmergencyAccess !== 'undefined' && isEmergencyAccess) { %>
      <div class="bg-red-500 text-white p-4 mb-6 rounded-lg shadow-lg">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center">
            <i class="fas fa-shield-alt text-white text-2xl mr-3"></i>
            <div>
              <h2 class="text-xl font-bold">🚨 EMERGENCY ACCESS</h2>
              <p class="text-sm opacity-90">
                Secure medical data access •
                <span id="access-time-display"></span>
              </p>
            </div>
          </div>
          <!-- Session Timer -->
          <div class="text-right">
            <p class="text-sm font-medium">Session expires in:</p>
            <p id="session-timer" class="text-2xl font-bold">5:00</p>
          </div>
        </div>

        <!-- Location Information -->
        <div
          id="location-section"
          class="bg-red-600 bg-opacity-50 rounded-lg p-3 mb-3"
        >
          <div class="flex items-start space-x-3">
            <i class="fas fa-map-marker-alt text-white text-lg mt-1"></i>
            <div class="flex-1">
              <h3 class="text-sm font-semibold text-white mb-1">
                <i class="fas fa-location-arrow mr-1"></i>
                Access Location
              </h3>

              <!-- Dynamic location content will be inserted here -->
              <div id="location-content">
                <div class="text-sm text-red-100">
                  <p class="font-medium">
                    <span class="location-loading"></span>
                    <span class="ml-2">Detecting location...</span>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Device Information -->
        <div
          id="device-section"
          class="bg-red-600 bg-opacity-50 rounded-lg p-3"
        >
          <div class="flex items-start space-x-3">
            <i class="fas fa-desktop text-white text-lg mt-1"></i>
            <div class="flex-1">
              <h3 class="text-sm font-semibold text-white mb-1">
                <i class="fas fa-desktop mr-1"></i>
                Device Information
              </h3>
              <div id="device-content" class="text-sm text-red-100">
                <p class="font-medium">
                  <span class="location-loading"></span>
                  <span class="ml-2">Analyzing device...</span>
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Security Notice -->
        <div
          id="security-notice"
          class="mt-3 p-2 bg-red-700 bg-opacity-50 rounded-lg text-center"
          style="display: none"
        >
          <p class="text-xs text-red-100">
            <i class="fas fa-bell mr-1"></i>
            <span id="security-message"></span>
          </p>
        </div>
      </div>
      <% } %>

      <!-- Offline Mode Warning -->
      <% if (typeof isOfflineMode !== 'undefined' && isOfflineMode) { %>
      <div
        class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4 mb-6 rounded-r-lg shadow-sm"
      >
        <div class="flex items-center">
          <i class="fas fa-wifi text-yellow-500 text-xl mr-3"></i>
          <div>
            <p class="font-semibold">Limited Access Mode</p>
            <p class="text-sm"><%= warning %></p>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Patient Header Card with Profile Image -->
      <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center mb-4">
          <!-- Profile Image Section -->
          <div class="mb-4 sm:mb-0 sm:mr-6 flex-shrink-0">
            <div id="profile-image-container">
              <!-- Profile image will be loaded here via JavaScript -->
              <div class="profile-placeholder">
                <span class="profile-initials" id="patient-initials">
                  <% let safeName = (patientName && typeof patientName ===
                  'string') ? patientName : 'Unknown Patient'; let initials =
                  safeName.split(' ').map(function(n) { return
                  n.charAt(0).toUpperCase(); }).join('').substring(0, 2); %> <%=
                  initials %>
                </span>
              </div>
            </div>
          </div>

          <!-- Patient Information -->
          <div class="flex-1 min-w-0">
            <h1 class="text-3xl font-bold text-gray-800 mb-2">
              <%= patientName %>
            </h1>

            <!-- Patient Date of Birth -->
            <% if (typeof patientDateOfBirth !== 'undefined' &&
            patientDateOfBirth) { %>
            <div class="mb-3">
              <p class="text-lg text-gray-600">
                <i class="fas fa-calendar-day mr-2 text-blue-500"></i>
                <span class="font-medium">DOB:</span>
                <span class="font-semibold text-gray-800"
                  ><%= patientDateOfBirth %></span
                >
              </p>
            </div>
            <% } %>

            <div class="flex flex-wrap gap-2 mb-3">
              <span
                class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium"
              >
                <i class="fas fa-database mr-1"></i>
                <%= containerName %>
              </span>
              <span
                class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-medium"
              >
                <i class="fas fa-folder-medical mr-1"></i>
                <%= folderName %>
              </span>
            </div>

            <!-- Important Notice -->
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3">
              <div class="flex items-start">
                <i class="fas fa-eye text-yellow-600 text-lg mr-2 mt-0.5"></i>
                <div>
                  <p class="text-sm font-medium text-yellow-800">
                    View Only Access
                  </p>
                  <p class="text-sm text-yellow-700">
                    Files cannot be downloaded for security reasons
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Patient Medical Files Section -->
      <div class="bg-white rounded-xl shadow-lg overflow-hidden">
        <div class="bg-gradient-to-r from-green-500 to-blue-600 px-6 py-4">
          <div class="flex items-center justify-between text-white">
            <div class="flex items-center">
              <i class="fas fa-file-medical-alt text-2xl mr-3"></i>
              <div>
                <h2 class="text-xl font-bold">Patient Medical Files</h2>
                <% if (files && files.length > 0) { %>
                <p class="text-sm opacity-90">
                  <%= files.length %> file(s) available
                </p>
                <% } else { %>
                <p class="text-sm opacity-90">No files found</p>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <div class="p-6">
          <!-- Safari iOS Notice -->
          <div
            id="safari-ios-notice"
            class="mb-4 p-3 bg-blue-50 border border-blue-200 rounded-lg"
            style="display: none"
          >
            <div class="flex items-start">
              <i class="fas fa-mobile-alt text-blue-600 mt-0.5 mr-2"></i>
              <div>
                <p class="text-sm font-medium text-blue-800">
                  iPhone/iPad Notice
                </p>
                <p class="text-sm text-blue-700">
                  Files will open in the same tab. Use the back button to
                  return.
                </p>
              </div>
            </div>
          </div>

          <% if (!files || files.length === 0) { %>
          <!-- No Files Message -->
          <div class="text-center py-12">
            <i class="fas fa-folder-open text-gray-300 text-6xl mb-4"></i>
            <h3 class="text-xl font-semibold text-gray-600 mb-2">
              No Medical Files Found
            </h3>
            <p class="text-gray-500">
              No files are available for this patient at this time.
            </p>
          </div>
          <% } else { %>
          <!-- Files List -->
          <div class="space-y-3">
            <% files.forEach(function(file, index) { %>
            <div
              class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm hover:shadow-md transition-all duration-200"
            >
              <!-- File Card Content -->
              <button
                class="file-link w-full text-left"
                data-container="<%= containerName %>"
                data-folder="<%= folderName %>"
                data-filename="<%= encodeURIComponent(file.name) %>"
                title="Tap to open file"
              >
                <div class="flex items-start space-x-4">
                  <!-- File Icon -->
                  <div class="flex-shrink-0">
                    <% var fileIcon = 'fa-file text-gray-500'; var iconBg =
                    'bg-gray-100'; if (file.contentType) { if
                    (file.contentType.indexOf('image') !== -1) { fileIcon =
                    'fa-file-image text-green-600'; iconBg = 'bg-green-100'; }
                    else if (file.contentType.indexOf('pdf') !== -1) { fileIcon
                    = 'fa-file-pdf text-red-600'; iconBg = 'bg-red-100'; } else
                    if (file.contentType.indexOf('word') !== -1) { fileIcon =
                    'fa-file-word text-blue-600'; iconBg = 'bg-blue-100'; } else
                    if (file.contentType.indexOf('excel') !== -1) { fileIcon =
                    'fa-file-excel text-green-700'; iconBg = 'bg-green-100'; }
                    else if (file.contentType.indexOf('text') !== -1) { fileIcon
                    = 'fa-file-alt text-gray-600'; iconBg = 'bg-gray-100'; } }
                    %>
                    <div
                      class="<%= iconBg %> rounded-lg p-3 w-12 h-12 flex items-center justify-center"
                    >
                      <i class="fas <%= fileIcon %> text-lg"></i>
                    </div>
                  </div>

                  <!-- File Details -->
                  <div class="flex-1 min-w-0">
                    <!-- File Name -->
                    <h3
                      class="text-lg font-semibold text-blue-600 hover:text-blue-800 mb-2 break-words"
                    >
                      <%= file.name %>
                    </h3>

                    <!-- File Metadata -->
                    <div class="space-y-2">
                      <!-- Date and Size Row -->
                      <div
                        class="flex flex-wrap items-center gap-4 text-sm text-gray-600"
                      >
                        <div class="flex items-center">
                          <i class="fas fa-calendar-alt mr-2 text-gray-400"></i>
                          <span
                            ><%= new
                            Date(file.lastModified).toLocaleDateString()
                            %></span
                          >
                        </div>
                        <div class="flex items-center">
                          <i class="fas fa-file-alt mr-2 text-gray-400"></i>
                          <span><%= formatFileSize(file.contentLength) %></span>
                        </div>
                      </div>

                      <!-- File Type and Action Row -->
                      <div class="flex items-center justify-between">
                        <div class="flex items-center">
                          <span
                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800"
                          >
                            <i class="fas fa-tag mr-1"></i>
                            <% if (file.contentType &&
                            file.contentType.indexOf('/') !== -1) { %> <%=
                            file.contentType.split('/')[1].toUpperCase() %> <% }
                            else { %> UNKNOWN <% } %>
                          </span>
                        </div>
                        <div
                          class="flex items-center text-blue-500 text-sm font-medium"
                        >
                          <i class="fas fa-hand-pointer mr-1"></i>
                          <span>Tap to open</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </button>
            </div>
            <% }); %>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Security Notice -->
      <div class="mt-6 bg-gray-50 border border-gray-200 rounded-xl p-4">
        <div class="flex items-center justify-center text-gray-600">
          <i class="fas fa-shield-alt mr-2"></i>
          <p class="text-sm font-medium">
            Secure Emergency Access • CompassPoint Health PRMS
          </p>
        </div>
        <p class="text-center text-xs text-gray-500 mt-1">
          For assistance, contact emergency medical services or facility
          administrator
        </p>
      </div>

      <!-- Session Expired Modal -->
      <div
        id="expired-modal"
        class="fixed inset-0 z-50 hidden overflow-y-auto bg-black bg-opacity-75"
      >
        <div
          class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center"
        >
          <div
            class="bg-white rounded-xl shadow-2xl transform transition-all max-w-md w-full p-8"
          >
            <div
              class="w-16 h-16 mx-auto mb-4 bg-red-100 rounded-full flex items-center justify-center"
            >
              <i class="fas fa-clock text-red-600 text-2xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-gray-800 mb-4">
              Session Expired
            </h2>
            <p class="text-gray-600 mb-6">
              Your emergency access session has expired for security reasons.
              Please scan the SmartToken again to access patient data.
            </p>
            <div class="bg-red-50 rounded-lg p-4 mb-6">
              <p class="text-sm text-red-800">
                <i class="fas fa-shield-alt mr-2"></i>
                Emergency access sessions are limited to 5 minutes for patient
                privacy and security.
              </p>
            </div>
            <button
              onclick="closeExpiredModal()"
              class="bg-red-500 hover:bg-red-600 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200"
            >
              Close Window
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Global variables
      const CONTAINER_NAME = "<%= containerName %>";
      const FOLDER_NAME = "<%= folderName %>";
      const PATIENT_NAME = "<%= patientName %>";
      const TOKEN_ID = "<%= tokenId %>";

      // Enhanced API Configuration for Mobile Networks
      const getApiServerUrl = () => {
        const currentOrigin = window.location.origin;
        const hostname = window.location.hostname;
        const port = window.location.port;

        console.log("API URL Detection:", {
          currentOrigin,
          hostname,
          port,
          userAgent: navigator.userAgent,
        });

        // Development environment detection
        const isDevelopment =
          hostname === "localhost" ||
          hostname === "127.0.0.1" ||
          hostname.startsWith("192.168.") ||
          hostname.startsWith("10.") ||
          port === "5173" ||
          port === "3000" ||
          currentOrigin.includes("localhost");

        if (isDevelopment) {
          if (hostname.startsWith("192.168.") || hostname.startsWith("10.")) {
            const baseIP = hostname;
            const apiUrl = `http://${baseIP}:5000`;
            console.log("Mobile network detected, using:", apiUrl);
            return apiUrl;
          } else if (hostname === "localhost" || hostname === "127.0.0.1") {
            console.log("Desktop detected, using localhost");
            return "http://localhost:5000";
          } else {
            console.log("Development fallback, using current origin");
            return window.location.origin.replace(/:\d+$/, ":5000");
          }
        } else {
          console.log("Production detected, using same origin");
          return window.location.origin;
        }
      };

      // API Configuration with retry logic
      const API_CONFIG = {
        baseURL: getApiServerUrl(),
        endpoints: {
          deviceFingerprint: "/patients/verify/",
          profileImage: "/api/blobs/",
          deviceLocation: "/api/device-location",
          fileView: "/patients/file/",
          status: "/api/status",
          ipLocation: "/api/ip-location",
        },

        async testConnection() {
          try {
            console.log(`Testing API connection to: ${this.baseURL}`);
            const response = await fetch(
              `${this.baseURL}${this.endpoints.status}`,
              {
                method: "GET",
                headers: {
                  "Content-Type": "application/json",
                },
                signal: AbortSignal.timeout(10000),
              }
            );

            if (response.ok) {
              const status = await response.json();
              console.log("API server connection successful:", status);
              return { success: true, status };
            } else {
              console.warn(
                "API server responded with status:",
                response.status
              );
              return { success: false, status: response.status };
            }
          } catch (error) {
            console.error("API server connection failed:", error);
            return { success: false, error: error.message };
          }
        },

        async findWorkingApiUrl() {
          const possibleUrls = [
            this.baseURL,
            "http://localhost:5000",
            `http://${window.location.hostname}:5000`,
            window.location.origin.replace(/:\d+$/, ":5000"),
          ];

          console.log("Testing possible API URLs:", possibleUrls);

          for (const url of possibleUrls) {
            try {
              const response = await fetch(`${url}/api/status`, {
                method: "GET",
                signal: AbortSignal.timeout(5000),
              });

              if (response.ok) {
                console.log(`Found working API URL: ${url}`);
                this.baseURL = url;
                return url;
              }
            } catch (error) {
              console.log(`Failed to connect to: ${url}`);
            }
          }

          console.error("No working API URL found");
          return null;
        },
      };

      // Network-aware fetch with retry logic
      async function enhancedFetch(url, options = {}) {
        const maxRetries = 3;
        const retryDelay = 1000;

        for (let attempt = 1; attempt <= maxRetries; attempt++) {
          try {
            console.log(`Fetch attempt ${attempt}/${maxRetries}: ${url}`);

            const response = await fetch(url, {
              ...options,
              signal: AbortSignal.timeout(15000),
            });

            if (response.ok) {
              console.log(`Fetch successful on attempt ${attempt}`);
              return response;
            } else {
              console.warn(
                `Fetch failed with status ${response.status} on attempt ${attempt}`
              );
              if (attempt === maxRetries) {
                throw new Error(
                  `HTTP ${response.status}: ${response.statusText}`
                );
              }
            }
          } catch (error) {
            console.error(`Fetch attempt ${attempt} failed:`, error.message);

            if (attempt === maxRetries) {
              throw error;
            }

            if (attempt < maxRetries) {
              console.log(`Waiting ${retryDelay}ms before retry...`);
              await new Promise((resolve) => setTimeout(resolve, retryDelay));
            }
          }
        }
      }

      // Initialize device and location tracking
      let deviceFingerprintingService = null;
      let currentLocation = null;
      let deviceInfo = null;

      // Function to get patient initials
      function getPatientInitials(name) {
        return name
          .split(" ")
          .map((n) => n.charAt(0))
          .join("")
          .substring(0, 2)
          .toUpperCase();
      }

      // Load profile image
      function loadProfileImage() {
        const profileImageContainer = document.getElementById(
          "profile-image-container"
        );
        const profileImageUrl = `${API_CONFIG.baseURL}/api/blobs/${CONTAINER_NAME}/${FOLDER_NAME}/profile-image`;

        console.log(`Loading profile image from: ${profileImageUrl}`);

        const img = document.createElement("img");
        img.className = "profile-image";
        img.alt = `${PATIENT_NAME} - Profile Photo`;

        img.onload = function () {
          profileImageContainer.innerHTML = "";
          profileImageContainer.appendChild(img);
          console.log("Profile image loaded successfully");
        };

        img.onerror = function () {
          console.log("Profile image not found, using initials placeholder");
          const initialsElement = document.getElementById("patient-initials");
          if (initialsElement) {
            initialsElement.textContent = getPatientInitials(PATIENT_NAME);
          }
        };

        img.src = profileImageUrl;
      }

      // Initialize device fingerprinting
      async function initializeDeviceFingerprinting() {
        try {
          console.log("Initializing device fingerprinting...");

          const isMobile = /Mobile|Android|iPhone|iPad|iPod/i.test(
            navigator.userAgent
          );
          const isIOSSafari =
            /iPhone|iPad|iPod/i.test(navigator.userAgent) &&
            /Safari/i.test(navigator.userAgent) &&
            !/Chrome/i.test(navigator.userAgent);

          console.log(
            `Device type: ${
              isIOSSafari ? "iOS Safari" : isMobile ? "Mobile" : "Desktop"
            }`
          );

          if (typeof DeviceFingerprintingService !== "undefined") {
            deviceFingerprintingService = new DeviceFingerprintingService();
            console.log("Device fingerprinting service initialized");

            const timeout = isIOSSafari ? 5000 : isMobile ? 8000 : 12000;
            console.log(`Using ${timeout}ms timeout for fingerprinting`);

            let fingerprint = null;
            let attempts = 0;
            const maxAttempts = 3;

            while (!fingerprint && attempts < maxAttempts) {
              attempts++;
              console.log(`Fingerprint attempt ${attempts}/${maxAttempts}`);

              try {
                const fingerprintPromise =
                  deviceFingerprintingService.generateFingerprint();
                const timeoutPromise = new Promise((resolve) =>
                  setTimeout(() => resolve(null), timeout)
                );

                fingerprint = await Promise.race([
                  fingerprintPromise,
                  timeoutPromise,
                ]);

                if (fingerprint) {
                  console.log(`Fingerprint generated on attempt ${attempts}:`, {
                    hash: fingerprint.hash,
                    method: fingerprint.details?.collectMethod,
                    consistency: fingerprint.metadata?.consistency,
                  });
                  break;
                } else {
                  console.warn(`Attempt ${attempts} timed out, retrying...`);
                  await new Promise((resolve) => setTimeout(resolve, 500));
                }
              } catch (error) {
                console.warn(`Attempt ${attempts} failed:`, error.message);
                await new Promise((resolve) => setTimeout(resolve, 500));
              }
            }

            if (fingerprint) {
              updateDeviceSection(fingerprint);
              await sendDeviceFingerprint(fingerprint);
              return fingerprint;
            } else {
              console.warn(
                "All fingerprinting attempts failed, using fallback"
              );
              const fallbackFingerprint = generateFallbackFingerprint();
              updateDeviceSection(fallbackFingerprint);
              await sendDeviceFingerprint(fallbackFingerprint);
              return fallbackFingerprint;
            }
          } else {
            console.error(
              "DeviceFingerprintingService not available - using fallback"
            );
            const fallbackFingerprint = generateFallbackFingerprint();
            updateDeviceSection(fallbackFingerprint);
            await sendDeviceFingerprint(fallbackFingerprint);
            return fallbackFingerprint;
          }
        } catch (error) {
          console.error("Device fingerprinting failed:", error);
          const fallbackFingerprint = generateFallbackFingerprint();
          updateDeviceSection(fallbackFingerprint);
          await sendDeviceFingerprint(fallbackFingerprint);
          return fallbackFingerprint;
        }
      }

      // Generate fallback fingerprint
      function generateFallbackFingerprint() {
        const userAgent = navigator.userAgent;
        const isIOSSafari =
          /iPhone|iPad|iPod/i.test(userAgent) &&
          /Safari/i.test(userAgent) &&
          !/Chrome/i.test(userAgent);
        const isMobile = /Mobile|Android|iPhone|iPad|iPod/i.test(userAgent);

        const stableComponents = {
          userAgent: userAgent,
          language: navigator.language || "en-US",
          platform: navigator.platform || "unknown",
          cookieEnabled: navigator.cookieEnabled,
          hardwareConcurrency: navigator.hardwareConcurrency || 0,
          maxTouchPoints: navigator.maxTouchPoints || 0,
          screenWidth: screen.width,
          screenHeight: screen.height,
          screenColorDepth: screen.colorDepth,
          screenAvailWidth: screen.availWidth,
          screenAvailHeight: screen.availHeight,
          pixelRatio: Math.round((window.devicePixelRatio || 1) * 100) / 100,
          timezoneOffset: new Date().getTimezoneOffset(),
          timezone: (() => {
            try {
              return Intl.DateTimeFormat().resolvedOptions().timeZone;
            } catch (e) {
              return "UTC";
            }
          })(),
          isAndroid: /Android/i.test(userAgent),
          isMobile: isMobile,
          isIOSSafari: isIOSSafari,
          method: isIOSSafari
            ? "ios_safari_fallback"
            : isMobile
            ? "mobile_fallback"
            : "desktop_fallback",
        };

        const orderedKeys = Object.keys(stableComponents).sort();
        const orderedString = orderedKeys
          .map((key) => {
            const value = stableComponents[key];
            return `${key}:${value}`;
          })
          .join("|");

        function createHash(str) {
          let hash = 0;
          if (str.length === 0) return hash.toString(16);

          for (let i = 0; i < str.length; i++) {
            const char = str.charCodeAt(i);
            hash = (hash << 5) - hash + char;
            hash = hash & hash;
          }

          return Math.abs(hash).toString(16);
        }

        const hash = createHash(orderedString);

        console.log("Fallback fingerprint generated:", {
          hash: hash,
          method: stableComponents.method,
          componentCount: orderedKeys.length,
        });

        return {
          hash: hash,
          details: stableComponents,
          metadata: {
            deviceName: getDeviceNameFromUserAgent(userAgent),
            browserName: getBrowserNameFromUserAgent(userAgent),
            osName: getOSNameFromUserAgent(userAgent),
            deviceType: isMobile ? "mobile" : "desktop",
            method: stableComponents.method,
            isAndroid: /Android/i.test(userAgent),
            isMobile: isMobile,
            isIOSSafari: isIOSSafari,
            consistency: "fallback",
            fallback: true,
          },
        };
      }

      // Helper functions for device detection
      function getDeviceNameFromUserAgent(userAgent) {
        if (/iPhone/i.test(userAgent)) return "iPhone";
        if (/iPad/i.test(userAgent)) return "iPad";
        if (/Android/i.test(userAgent)) return "Android Device";
        if (/Mac/i.test(userAgent)) return "Mac";
        if (/Windows/i.test(userAgent)) return "Windows PC";
        return "Unknown Device";
      }

      function getBrowserNameFromUserAgent(userAgent) {
        if (/Safari/i.test(userAgent) && !/Chrome/i.test(userAgent))
          return "Safari";
        if (/Chrome/i.test(userAgent)) return "Chrome";
        if (/Firefox/i.test(userAgent)) return "Firefox";
        if (/Edge/i.test(userAgent)) return "Edge";
        return "Unknown Browser";
      }

      function getOSNameFromUserAgent(userAgent) {
        if (/iPhone|iPad/i.test(userAgent)) return "iOS";
        if (/Android/i.test(userAgent)) return "Android";
        if (/Mac OS X/i.test(userAgent)) return "macOS";
        if (/Windows/i.test(userAgent)) return "Windows";
        return "Unknown OS";
      }

      // Get GPS location
      async function getCurrentLocation() {
        return new Promise((resolve) => {
          console.log("Starting GPS location request...");

          if (!navigator.geolocation) {
            console.log("Geolocation not supported by this browser");
            updateLocationSection(null, {
              type: "unsupported",
              message: "Geolocation not supported",
            });
            resolve(null);
            return;
          }

          const isMobile = /Mobile|Android|iPhone|iPad|iPod/i.test(
            navigator.userAgent
          );
          const isIOSSafari =
            /iPhone|iPad|iPod/i.test(navigator.userAgent) &&
            /Safari/i.test(navigator.userAgent) &&
            !/Chrome/i.test(navigator.userAgent);

          console.log(
            `Requesting GPS on ${
              isIOSSafari ? "iOS Safari" : isMobile ? "mobile" : "desktop"
            }`
          );

          updateLocationSection(null, {
            type: "requesting",
            message: "Requesting GPS permission...",
            isMobile: isMobile,
          });

          const options = {
            enableHighAccuracy: true,
            timeout: isIOSSafari ? 15000 : isMobile ? 20000 : 30000,
            maximumAge: isMobile ? 30000 : 60000,
          };

          console.log("GPS options:", options);

          const handleSuccess = (position) => {
            const location = {
              latitude: position.coords.latitude,
              longitude: position.coords.longitude,
              accuracy: position.coords.accuracy,
              altitude: position.coords.altitude,
              heading: position.coords.heading,
              speed: position.coords.speed,
              timestamp: new Date().toISOString(),
            };

            console.log("GPS location obtained:", {
              lat: location.latitude.toFixed(6),
              lon: location.longitude.toFixed(6),
              accuracy: Math.round(location.accuracy) + "m",
              timestamp: location.timestamp,
            });

            updateLocationSection(location, null);
            sendGPSLocation(location);
            resolve(location);
          };

          const handleError = (error) => {
            let errorMessage = "GPS location unavailable";
            let errorType = "error";

            console.log("GPS error:", {
              code: error.code,
              message: error.message,
              isMobile: isMobile,
              isIOSSafari: isIOSSafari,
            });

            switch (error.code) {
              case error.PERMISSION_DENIED:
                errorMessage = isMobile
                  ? "GPS permission denied. Please enable location in your browser settings."
                  : "GPS permission denied";
                errorType = "permission_denied";
                break;
              case error.POSITION_UNAVAILABLE:
                errorMessage = isMobile
                  ? "GPS position unavailable. Please ensure location services are enabled."
                  : "GPS position unavailable";
                errorType = "unavailable";
                break;
              case error.TIMEOUT:
                errorMessage = isMobile
                  ? "GPS request timed out. Please try again or check your connection."
                  : "GPS request timed out";
                errorType = "timeout";
                break;
              default:
                errorMessage = "GPS error occurred";
                errorType = "unknown";
                break;
            }

            console.log(`GPS fallback: ${errorMessage}`);

            updateLocationSection(null, {
              type: errorType,
              message: errorMessage,
              isMobile: isMobile,
            });

            fallbackToIPLocation();
            resolve(null);
          };

          try {
            navigator.geolocation.getCurrentPosition(
              handleSuccess,
              handleError,
              options
            );
          } catch (error) {
            console.error("GPS request failed:", error);
            updateLocationSection(null, {
              type: "error",
              message: "GPS request failed",
              isMobile: isMobile,
            });
            fallbackToIPLocation();
            resolve(null);
          }
        });
      }

      // Fallback to IP location
      async function fallbackToIPLocation() {
        try {
          console.log("Falling back to IP-based location...");

          updateLocationSection(null, {
            type: "ip_fallback",
            message: "Using IP-based location...",
          });

          const apiUrl = `${API_CONFIG.baseURL}/api/ip-location`;
          const response = await fetch(apiUrl, {
            method: "GET",
            headers: {
              "Content-Type": "application/json",
            },
          });

          if (response.ok) {
            const data = await response.json();
            console.log("IP location received:", data);

            if (data.success && data.location) {
              updateLocationSection(null, data.location);
            } else {
              updateLocationSection(null, {
                type: "error",
                message: "Location unavailable",
              });
            }
          } else {
            console.error("IP location request failed:", response.status);
            updateLocationSection(null, {
              type: "error",
              message: "Location services unavailable",
            });
          }
        } catch (error) {
          console.error("IP location fallback failed:", error);
          updateLocationSection(null, {
            type: "error",
            message: "Location unavailable",
          });
        }
      }

      // Send GPS location to server
      async function sendGPSLocation(location) {
        try {
          const payload = {
            tokenId: TOKEN_ID,
            location: location,
            timestamp: new Date().toISOString(),
          };

          const apiUrl = `${API_CONFIG.baseURL}/api/device-location`;
          console.log(`Sending GPS location to: ${apiUrl}`);

          const response = await fetch(apiUrl, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
          });

          if (response.ok) {
            const result = await response.json();
            console.log("GPS location sent successfully:", result);
          } else {
            console.log("GPS location send failed:", response.status);
          }
        } catch (error) {
          console.error("Error sending GPS location:", error);
        }
      }

