      /**
       * Smart Loading Strategy
       */
      async function loadFingerprintJSBrowserService() {
        console.log(
          "📥 Smart FingerprintJS Pro loading with location support..."
        );

        const isMobile = /iPhone|iPad|iPod|Android|Mobile/i.test(
          navigator.userAgent
        );
        console.log("📱 Device type:", isMobile ? "Mobile" : "Desktop");

        if (isMobile) {
          console.log("📱 Mobile detected - Using enhanced CDN approach");
          try {
            await loadFingerprintJSDirectlyRobust();
            return;
          } catch (mobileError) {
            console.error("❌ Mobile CDN failed:", mobileError.message);
            throw mobileError;
          }
        }

        console.log("🖥️ Desktop detected - Trying local script first");
        const scriptUrl = `${API_CONFIG.baseURL}/static/js/fingerprintjs-browser.js`;

        try {
          await loadLocalScript(scriptUrl);
          console.log("✅ Local script loaded successfully");
          return;
        } catch (localError) {
          console.warn(
            "⚠️ Local script failed, trying CDN fallback:",
            localError.message
          );
          await loadFingerprintJSDirectlyRobust();
        }
      }

      /**
       * Load Local Script (Desktop)
       */
      async function loadLocalScript(scriptUrl) {
        return new Promise((resolve, reject) => {
          if (window.fingerprintService && window.FingerprintJSBrowser) {
            console.log("✅ Local service already available");
            resolve();
            return;
          }

          const script = document.createElement("script");
          script.src = scriptUrl;
          script.async = true;

          const timeoutId = setTimeout(() => {
            script.remove();
            reject(new Error("Local script loading timeout"));
          }, 8000);

          script.onload = () => {
            clearTimeout(timeoutId);
            console.log("✅ Local script loaded successfully");

            let attempts = 0;
            const checkService = () => {
              attempts++;
              if (window.fingerprintService && window.FingerprintJSBrowser) {
                resolve();
              } else if (attempts < 20) {
                setTimeout(checkService, 100);
              } else {
                reject(
                  new Error("Local service not available after script load")
                );
              }
            };
            checkService();
          };

          script.onerror = () => {
            clearTimeout(timeoutId);
            reject(new Error("Local script loading failed"));
          };

          document.head.appendChild(script);
        });
      }

      /**
       * Enhanced Initialize FingerprintJS Pro with Location
       */
      async function initFingerprintJS() {
        const maxRetries = 2;
        let lastError = null;

        for (let attempt = 1; attempt <= maxRetries; attempt++) {
          try {
            console.log(
              `🔧 Initializing enhanced FingerprintJS Pro (attempt ${attempt}/${maxRetries})...`
            );

            updateDeviceStatus(null, {
              loading: true,
              message: `Initializing security verification (${attempt}/${maxRetries})...`,
            });

            await loadFingerprintJSBrowserService();

            if (!window.fingerprintService) {
              throw new Error(
                "FingerprintJS Pro service not available after loading"
              );
            }

            fpService = window.fingerprintService;
            console.log(
              "🔗 Enhanced FingerprintJS Pro service instance obtained"
            );

            updateDeviceStatus(null, {
              loading: true,
              message: "Connecting to security verification API...",
            });

            await fpService.initialize();
            fpjsInitialized = true;

            console.log(
              "✅ Enhanced FingerprintJS Pro service initialized successfully"
            );

            updateDeviceStatus(null, {
              loading: true,
              message: "Generating device fingerprint with location...",
            });

            await sendDeviceFingerprint();
            return;
          } catch (error) {
            lastError = error;
            console.error(
              `❌ Enhanced FingerprintJS Pro initialization attempt ${attempt} failed:`,
              error
            );

            if (attempt < maxRetries) {
              updateDeviceStatus(null, {
                loading: true,
                message: `Retrying security verification initialization...`,
              });
              await new Promise((resolve) => setTimeout(resolve, 3000));
            }
          }
        }

        console.error(
          "❌ All enhanced FingerprintJS Pro initialization attempts failed"
        );
        updateDeviceStatus(null, {
          success: false,
          error: `Security verification initialization failed: ${lastError?.message}`,
          critical: true,
        });
      }

      /**
       * Send Enhanced Device Fingerprint with Location
       */
      async function sendDeviceFingerprint() {
        try {
          console.log(
            "🚀 Starting enhanced FingerprintJS Pro device verification with location..."
          );

          if (!fpjsInitialized || !fpService) {
            throw new Error("FingerprintJS Pro service not ready");
          }

          console.log(
            "🔍 Generating enhanced FingerprintJS Pro fingerprint..."
          );
          const fingerprint = await fpService.generateFingerprint({
            tag: "emergency_smarttoken_access",
            linkedId: TOKEN_ID,
          });

          if (!fingerprint || !fingerprint.visitorId) {
            throw new Error("Invalid fingerprint - no visitor ID generated");
          }

          console.log("✅ Enhanced fingerprint generated with location data");

          // Update location display
          updateLocationDisplay();

          // Include comprehensive verification payload
          const verificationPayload = {
            deviceFingerprint: fingerprint,
            locationData: {
              gps: locationData.gps,
              fingerprintjsIP: locationData.fingerprintjsIP,
              best: locationData.gps || locationData.fingerprintjsIP,
            },
            hasLocationData: !!(
              locationData.gps || locationData.fingerprintjsIP
            ),
            locationSources: {
              gps: locationData.hasGPS,
              fingerprintjsIP: locationData.hasFPJSLocation,
            },
            extendedData: {
              ipInfo: fingerprint.ipInfo,
              botd: fingerprint.botd,
              vpn: fingerprint.vpn,
            },
          };

          console.log("📤 Sending enhanced verification to server...", {
            visitorId: fingerprint.visitorId,
            confidence: fingerprint.confidence,
            hasLocation: verificationPayload.hasLocationData,
            hasIPInfo: !!fingerprint.ipInfo,
          });

          const verifyUrl = `${API_CONFIG.baseURL}/patients/verify/${TOKEN_ID}`;
          const response = await fetch(verifyUrl, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(verificationPayload),
          });

          if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
          }

          const result = await response.json();

          if (result.success) {
            console.log("✅ Enhanced device verification successful:", {
              visitorId: result.visitorId,
              isRegistered: result.isRegisteredDevice,
              alertsTriggered: result.alertsTriggered,
              confidence: result.confidence,
              locationProcessed: result.locationProcessed,
            });

            updateDeviceStatus(fingerprint, result);
          } else {
            console.error("❌ Device verification failed:", result.message);
            updateDeviceStatus(fingerprint, {
              success: false,
              error: result.message,
              service: result.service || "fingerprintjs_pro",
            });
          }

          return result;
        } catch (error) {
          console.error("❌ Enhanced device verification failed:", error);
          updateLocationDisplay(); // Still update location display with whatever we have
          updateDeviceStatus(null, {
            success: false,
            error: error.message,
            critical: true,
          });
          return { success: false, error: error.message };
        }
      }

      /**
       * Enhanced Device Status Updates
       */
      function updateDeviceStatus(fingerprint, serverResponse) {
        const deviceContent = document.getElementById("device-content");
        const securityNotice = document.getElementById("security-notice");
        const securityMessage = document.getElementById("security-message");

        if (!deviceContent) return;

        if (serverResponse.loading) {
          const message =
            serverResponse.message || "Initializing security verification...";
          deviceContent.innerHTML = `
            <div class="text-sm text-red-100">
                <p class="font-medium">
                    <span class="location-loading"></span>
                    <span class="ml-2">${message}</span>
                </p>
                <p class="text-xs text-red-200 mt-1">
                    <i class="fas fa-fingerprint mr-1"></i>
                    Advanced device identification with location in progress...
                </p>
            </div>
          `;
          return;
        }

        if (fingerprint && serverResponse.success) {
          const meta = fingerprint.metadata;
          const isRegistered = serverResponse.isRegisteredDevice;

          deviceContent.innerHTML = `
            <div class="text-sm text-red-100">
                <p class="font-medium">
                    <i class="fas fa-${
                      meta.deviceType === "mobile" ? "mobile-alt" : "laptop"
                    } mr-1"></i>
                    ${meta.deviceName} - ${meta.browserName} on ${meta.osName}
                </p>
                <div class="mt-2 flex items-center">
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium ${
                      isRegistered
                        ? "bg-green-500 bg-opacity-75 text-green-100"
                        : "bg-yellow-500 bg-opacity-75 text-yellow-100"
                    }">
                        <i class="fas fa-${
                          isRegistered ? "check-circle" : "exclamation-triangle"
                        } mr-1"></i>
                        ${
                          isRegistered
                            ? "Registered Device"
                            : "Unregistered Device"
                        }
                    </span>
                </div>
                <p class="text-xs text-red-300 mt-1">
                    <i class="fas fa-shield-alt mr-1"></i>
                    Device Verification (${Math.round(
                      meta.confidenceScore * 100
                    )}% confidence)
                    ${meta.hasIPLocation ? " + IP Location included" : ""}
                </p>
                <p class="text-xs text-red-300 mt-1">
                    Visitor ID: ${fingerprint.visitorId}
                </p>
            </div>
          `;

          if (!isRegistered) {
            securityMessage.textContent = serverResponse.alertsTriggered
              ? "Emergency contacts have been notified of this unregistered device access with location data."
              : "This device is not registered. Emergency contacts may be notified with location information.";
            securityNotice.style.display = "block";
          } else {
            securityNotice.style.display = "none";
          }
        } else {
          const isCritical = serverResponse.critical;
          deviceContent.innerHTML = `
            <div class="text-sm text-red-100">
                <p class="font-medium">
                    <i class="fas fa-exclamation-triangle mr-1"></i>
                    ${
                      isCritical ? "CRITICAL: " : ""
                    }Security verification failed
                </p>
                <p class="text-xs text-red-200 mt-1">
                    ${serverResponse.error || "Unable to verify device"}
                </p>
                ${
                  isCritical
                    ? '<p class="text-xs text-red-200 mt-1"><strong>Device fingerprinting is required for security.</strong></p>'
                    : ""
                }
            </div>
          `;

          securityMessage.textContent = isCritical
            ? "CRITICAL: Device verification failed. Access may be restricted."
            : "Device verification failed. Emergency protocols may be activated.";
          securityNotice.style.display = "block";
        }
      }

