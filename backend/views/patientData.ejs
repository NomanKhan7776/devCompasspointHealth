      // ✅ MOBILE FALLBACK: Generate basic mobile fingerprint
      // ✅ ENHANCED: Consistent mobile fallback fingerprint
      function generateEnhancedMobileFallbackFingerprint() {
        const userAgent = navigator.userAgent;
        const isIOSSafari =
          /iPhone|iPad|iPod/i.test(userAgent) &&
          /Safari/i.test(userAgent) &&
          !/Chrome/i.test(userAgent);
        const isMobile = /Mobile|Android|iPhone|iPad|iPod/i.test(userAgent);

        // ✅ CONSISTENCY FIX: Use stable, ordered components
        const stableComponents = {
          // Core stable values (never change)
          userAgent: userAgent,
          language: navigator.language || "en-US",
          platform: navigator.platform || "unknown",
          cookieEnabled: navigator.cookieEnabled,

          // Hardware info (stable)
          hardwareConcurrency: navigator.hardwareConcurrency || 0,
          maxTouchPoints: navigator.maxTouchPoints || 0,

          // Screen info (stable)
          screenWidth: screen.width,
          screenHeight: screen.height,
          screenColorDepth: screen.colorDepth,
          screenAvailWidth: screen.availWidth,
          screenAvailHeight: screen.availHeight,

          // Display info (stable)
          pixelRatio: Math.round((window.devicePixelRatio || 1) * 100) / 100,

          // Time zone (stable)
          timezoneOffset: new Date().getTimezoneOffset(),
          timezone: (() => {
            try {
              return Intl.DateTimeFormat().resolvedOptions().timeZone;
            } catch (e) {
              return "UTC";
            }
          })(),

          // Device type info
          isAndroid: /Android/i.test(userAgent),
          isMobile: isMobile,
          isIOSSafari: isIOSSafari,

          // Method identifier
          method: isIOSSafari
            ? "ios_safari_enhanced_fallback_v6"
            : isMobile
            ? "mobile_enhanced_fallback_v6"
            : "desktop_enhanced_fallback_v6",
        };

        // ✅ CONSISTENCY FIX: Create ordered string for hashing
        const orderedKeys = Object.keys(stableComponents).sort();
        const orderedString = orderedKeys
          .map((key) => {
            const value = stableComponents[key];
            return `${key}:${value}`;
          })
          .join("|");

        // ✅ CONSISTENCY FIX: Enhanced hash function
        function createConsistentHash(str) {
          let hash = 0;
          if (str.length === 0) return hash.toString(16);

          for (let i = 0; i < str.length; i++) {
            const char = str.charCodeAt(i);
            hash = (hash << 5) - hash + char;
            hash = hash & hash; // Convert to 32bit integer
          }

          return Math.abs(hash).toString(16);
        }

        const hash = createConsistentHash(orderedString);

        console.log("🔧 Enhanced fallback fingerprint generated:", {
          hash: hash,
          method: stableComponents.method,
          componentCount: orderedKeys.length,
          hashSource: orderedString.substring(0, 100) + "...",
        });

        return {
          hash: hash,
          details: stableComponents,
          metadata: {
            deviceName: getDeviceNameFromUserAgent(userAgent),
            browserName: getBrowserNameFromUserAgent(userAgent),
            osName: getOSNameFromUserAgent(userAgent),
            deviceType: isMobile ? "mobile" : "desktop",
            method: stableComponents.method,
            isAndroid: /Android/i.test(userAgent),
            isMobile: isMobile,
            isIOSSafari: isIOSSafari,
            consistency: "enhanced_fallback_v6",
            fallback: true,
          },
        };
      }

      // ✅ Helper functions for mobile fallback
      function getDeviceNameFromUserAgent(userAgent) {
        if (/iPhone/i.test(userAgent)) return "iPhone";
        if (/iPad/i.test(userAgent)) return "iPad";
        if (/Android/i.test(userAgent)) return "Android Device";
        if (/Mac/i.test(userAgent)) return "Mac";
        if (/Windows/i.test(userAgent)) return "Windows PC";
        return "Unknown Device";
      }

      function getBrowserNameFromUserAgent(userAgent) {
        if (/Safari/i.test(userAgent) && !/Chrome/i.test(userAgent))
          return "Safari";
        if (/Chrome/i.test(userAgent)) return "Chrome";
        if (/Firefox/i.test(userAgent)) return "Firefox";
        if (/Edge/i.test(userAgent)) return "Edge";
        return "Unknown Browser";
      }

      function getOSNameFromUserAgent(userAgent) {
        if (/iPhone|iPad/i.test(userAgent)) return "iOS";
        if (/Android/i.test(userAgent)) return "Android";
        if (/Mac OS X/i.test(userAgent)) return "macOS";
        if (/Windows/i.test(userAgent)) return "Windows";
        return "Unknown OS";
      }

      // Get GPS location
      // ✅ ENHANCED: GPS location with mobile optimization
      async function getCurrentLocation() {
        return new Promise((resolve) => {
          console.log("📍 Starting enhanced GPS location request...");

          // ✅ Check if geolocation is supported
          if (!navigator.geolocation) {
            console.log("❌ Geolocation not supported by this browser");
            updateLocationSection(null, {
              type: "unsupported",
              message: "Geolocation not supported",
            });
            resolve(null);
            return;
          }

          // ✅ Mobile-specific checks
          const isMobile = /Mobile|Android|iPhone|iPad|iPod/i.test(
            navigator.userAgent
          );
          const isIOSSafari =
            /iPhone|iPad|iPod/i.test(navigator.userAgent) &&
            /Safari/i.test(navigator.userAgent) &&
            !/Chrome/i.test(navigator.userAgent);

          console.log(
            `📱 Requesting GPS on ${
              isIOSSafari ? "iOS Safari" : isMobile ? "mobile" : "desktop"
            }`
          );

          // ✅ Show requesting status
          updateLocationSection(null, {
            type: "requesting",
            message: "Requesting GPS permission...",
            isMobile: isMobile,
          });

          // ✅ Enhanced GPS options for mobile
          const options = {
            enableHighAccuracy: true,
            timeout: isIOSSafari ? 15000 : isMobile ? 20000 : 30000, // Longer timeouts for mobile
            maximumAge: isMobile ? 30000 : 60000, // Shorter cache for mobile
          };

          console.log("⚙️ GPS options:", options);

          // ✅ Enhanced error handling for mobile
          const handleSuccess = (position) => {
            const location = {
              latitude: position.coords.latitude,
              longitude: position.coords.longitude,
              accuracy: position.coords.accuracy,
              altitude: position.coords.altitude,
              heading: position.coords.heading,
              speed: position.coords.speed,
              timestamp: new Date().toISOString(),
            };

            console.log("✅ GPS location obtained:", {
              lat: location.latitude.toFixed(6),
              lon: location.longitude.toFixed(6),
              accuracy: Math.round(location.accuracy) + "m",
              timestamp: location.timestamp,
            });

            // ✅ Update location display with GPS data
            updateLocationSection(location, null);

            // ✅ Send GPS location to server immediately
            sendGPSLocation(location);

            resolve(location);
          };

          const handleError = (error) => {
            let errorMessage = "GPS location unavailable";
            let errorType = "error";

            console.log("❌ GPS error:", {
              code: error.code,
              message: error.message,
              isMobile: isMobile,
              isIOSSafari: isIOSSafari,
            });

            switch (error.code) {
              case error.PERMISSION_DENIED:
                errorMessage = isMobile
                  ? "GPS permission denied. Please enable location in your browser settings."
                  : "GPS permission denied";
                errorType = "permission_denied";
                break;
              case error.POSITION_UNAVAILABLE:
                errorMessage = isMobile
                  ? "GPS position unavailable. Please ensure location services are enabled."
                  : "GPS position unavailable";
                errorType = "unavailable";
                break;
              case error.TIMEOUT:
                errorMessage = isMobile
                  ? "GPS request timed out. Please try again or check your connection."
                  : "GPS request timed out";
                errorType = "timeout";
                break;
              default:
                errorMessage = "GPS error occurred";
                errorType = "unknown";
                break;
            }

            console.log(`📍 GPS fallback: ${errorMessage}`);

            // ✅ Update location display with error info
            updateLocationSection(null, {
              type: errorType,
              message: errorMessage,
              isMobile: isMobile,
            });

            // ✅ Fall back to IP location
            fallbackToIPLocation();

            resolve(null);
          };

          // ✅ Request GPS position
          try {
            navigator.geolocation.getCurrentPosition(
              handleSuccess,
              handleError,
              options
            );
          } catch (error) {
            console.error("❌ GPS request failed:", error);
            updateLocationSection(null, {
              type: "error",
              message: "GPS request failed",
              isMobile: isMobile,
            });
            fallbackToIPLocation();
            resolve(null);
          }
        });
      }

      // ✅ NEW: Fallback to IP location
      async function fallbackToIPLocation() {
        try {
          console.log("🔄 Falling back to IP-based location...");

          // ✅ Show fallback status
          updateLocationSection(null, {
            type: "ip_fallback",
            message: "Using IP-based location...",
          });

          // ✅ Request IP location from server
          const apiUrl = `${API_CONFIG.baseURL}/api/ip-location`;
          const response = await fetch(apiUrl, {
            method: "GET",
            headers: {
              "Content-Type": "application/json",
            },
          });

          if (response.ok) {
            const data = await response.json();
            console.log("✅ IP location received:", data);

            if (data.success && data.location) {
