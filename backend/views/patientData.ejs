              if (accessTimeElement) {
                try {
                  const accessTime = new Date("<%= accessTime %>");
                  const localTimeString = accessTime.toLocaleString(undefined, {
                    month: "short",
                    day: "numeric",
                    hour: "2-digit",
                    minute: "2-digit",
                    hour12: true,
                  });
                  accessTimeElement.textContent = `Access granted at ${localTimeString}`;
                } catch (error) {
                  accessTimeElement.textContent = "Emergency access active";
                }
              }

              // iOS Safari optimizations
              const isIOSSafari =
                /iPhone|iPad|iPod/i.test(navigator.userAgent) &&
                /Safari/i.test(navigator.userAgent) &&
                !/Chrome/i.test(navigator.userAgent);

              if (isIOSSafari) {
                const notice = document.getElementById("safari-ios-notice");
                if (notice) {
                  notice.style.display = "block";
                }
              }

             // ✅ CHECK: Skip device verification for timer-based access to prevent duplicate alerts
      const isTimerBasedAccess = <%= typeof isTimerBasedAccess !== 'undefined' && isTimerBasedAccess ? 'true' : 'false' %>;
      const timerWasCancelled = <%= typeof timerWasCancelled !== 'undefined' && timerWasCancelled ? 'true' : 'false' %>;

      console.log("🔐 Timer-based access check:", { isTimerBasedAccess, timerWasCancelled });

      if (isTimerBasedAccess) {
        console.log("⏰ Timer-based access detected - skipping device verification to prevent duplicate alerts");

        // Update device status to show timer-based access
        updateDeviceStatus(null, {
          success: true,
          isRegisteredDevice: false, // Assume unregistered since alert was already handled
          message: "Timer-based emergency access - Device verification completed during timer",
          skipVerification: true
        });
      } else {
        // Initialize enhanced device verification (this will also get IP location)
        console.log("📱 Starting enhanced security verification initialization with location...");

        try {
          await initFingerprintJS();
        } catch (error) {
          console.error("❌ Critical error during enhanced security verification initialization:", error);
        }
      }
              }
            });
    </script>
  </body>
</html>
