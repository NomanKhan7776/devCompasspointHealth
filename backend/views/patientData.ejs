<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />

    <style>
      .profile-image {
        width: 150px;
        height: 150px;
        border-radius: 12px;
        object-fit: cover;
        border: 3px solid #e5e7eb;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      }
      .profile-placeholder {
        width: 150px;
        height: 150px;
        border-radius: 12px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 3px solid #e5e7eb;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      }
      .profile-initials {
        font-size: 3rem;
        font-weight: bold;
        color: white;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
      }
      .location-loading {
        display: inline-block;
        width: 20px;
        height: 20px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        border-top-color: #fff;
        animation: spin 1s ease-in-out infinite;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
      @media (max-width: 640px) {
        .profile-image,
        .profile-placeholder {
          width: 120px;
          height: 120px;
        }
        .profile-initials {
          font-size: 2.5rem;
        }
      }
      .location-section {
        transition: all 0.3s ease;
      }
      .location-success {
        background-color: rgba(34, 197, 94, 0.15);
        border: 1px solid rgba(34, 197, 94, 0.3);
      }
      .location-warning {
        background-color: rgba(245, 158, 11, 0.15);
        border: 1px solid rgba(245, 158, 11, 0.3);
      }
      .location-error {
        background-color: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.3);
      }
      .location-details {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
      }
      .location-details.expanded {
        max-height: 200px;
      }
      .alert-button {
        background: linear-gradient(45deg, #dc2626, #991b1b);
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(220, 38, 38, 0.3);
      }
      .alert-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(220, 38, 38, 0.4);
      }
      .alert-button:active {
        transform: translateY(0);
      }
      .alert-sending {
        background: linear-gradient(45deg, #059669, #047857);
        cursor: not-allowed;
      }
    </style>
  </head>
  <body class="bg-gray-100 min-h-screen">
    <div class="container mx-auto px-4 py-6 max-w-4xl">
      <!-- Emergency Access Banner -->
      <% if (typeof isEmergencyAccess !== 'undefined' && isEmergencyAccess) { %>
      <div class="bg-red-500 text-white p-4 mb-6 rounded-lg shadow-lg">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center">
            <i class="fas fa-shield-alt text-white text-2xl mr-3"></i>
            <div>
              <h2 class="text-xl font-bold">🚨 EMERGENCY ACCESS</h2>
              <p class="text-sm opacity-90">
                Secure medical data access •
                <span id="access-time-display"></span>
              </p>
            </div>
          </div>
          <!-- Session Timer -->
          <div class="text-right">
            <p class="text-sm font-medium">Session expires in:</p>
            <p id="session-timer" class="text-2xl font-bold">5:00</p>
          </div>
        </div>

        <!-- Enhanced Location Information -->
        <div
          id="location-section"
          class="bg-red-600 bg-opacity-50 rounded-lg p-3 mb-3 location-section"
        >
          <div class="flex items-start space-x-3">
            <i class="fas fa-map-marker-alt text-white text-lg mt-1"></i>
            <div class="flex-1">
              <div class="flex items-center justify-between">
                <h3 class="text-sm font-semibold text-white mb-1">
                  <i class="fas fa-location-arrow mr-1"></i>
                  SmartToken Access Location
                </h3>
                <button
                  id="location-toggle"
                  class="text-xs text-red-200 hover:text-white transition-colors"
                  onclick="toggleLocationDetails()"
                >
                  <i class="fas fa-chevron-down" id="location-chevron"></i>
                  Details
                </button>
              </div>

              <div id="location-content">
                <div class="text-sm text-red-100">
                  <p class="font-medium">
                    <span class="location-loading"></span>
                    <span class="ml-2">Detecting location...</span>
                  </p>
                </div>
              </div>

              <!-- Detailed Location Information -->
              <div
                id="location-details"
                class="location-details mt-2 space-y-1"
              >
                <div
                  id="gps-location"
                  class="text-xs text-red-200 flex items-center"
                >
                  <i class="fas fa-satellite mr-1"></i>
                  <span>GPS: Not available</span>
                </div>
                <div
                  id="ip-location"
                  class="text-xs text-red-200 flex items-center"
                >
                  <i class="fas fa-globe mr-1"></i>
                  <span>IP Location: Detecting...</span>
                </div>
                <div
                  id="network-info"
                  class="text-xs text-red-300 flex items-center"
                >
                  <i class="fas fa-network-wired mr-1"></i>
                  <span>Network: Unknown</span>
                </div>
                <div
                  id="location-accuracy"
                  class="text-xs text-red-300 flex items-center"
                >
                  <i class="fas fa-crosshairs mr-1"></i>
                  <span>Accuracy: Unknown</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Device Security Check -->
        <div
          id="device-section"
          class="bg-red-600 bg-opacity-50 rounded-lg p-3"
        >
          <div class="flex items-start space-x-3">
            <i class="fas fa-fingerprint text-white text-lg mt-1"></i>
            <div class="flex-1">
              <h3 class="text-sm font-semibold text-white mb-1">
                <i class="fas fa-shield-alt mr-1"></i>
                Device Security Verification
              </h3>
              <div id="device-content" class="text-sm text-red-100">
                <p class="font-medium">
                  <span class="location-loading"></span>
                  <span class="ml-2"
                    >Initializing security verification...</span
                  >
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Security Notice -->
        <div
          id="security-notice"
          class="mt-3 p-2 bg-red-700 bg-opacity-50 rounded-lg text-center"
          style="display: none"
        >
          <p class="text-xs text-red-100">
            <i class="fas fa-bell mr-1"></i>
            <span id="security-message"></span>
          </p>
        </div>
      </div>
      <% } %>

      <!-- Patient Header Card -->
      <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center mb-4">
          <!-- Profile Image Section -->
          <div class="mb-4 sm:mb-0 sm:mr-6 flex-shrink-0">
            <div id="profile-image-container">
              <div class="profile-placeholder">
                <span class="profile-initials" id="patient-initials">
                  <% let safeName = (patientName && typeof patientName ===
                  'string') ? patientName : 'Unknown Patient'; let initials =
                  safeName.split(' ').map(function(n) { return
                  n.charAt(0).toUpperCase(); }).join('').substring(0, 2); %> <%=
                  initials %>
                </span>
              </div>
            </div>
          </div>

          <!-- Patient Information -->
          <div class="flex-1 min-w-0">
            <h1 class="text-3xl font-bold text-gray-800 mb-2">
              <%= patientName %>
            </h1>

            <!-- Patient Date of Birth -->
            <% if (typeof patientDateOfBirth !== 'undefined' &&
            patientDateOfBirth) { %>
            <div class="mb-3">
              <p class="text-lg text-gray-600">
                <i class="fas fa-calendar-day mr-2 text-blue-500"></i>
                <span class="font-medium">DOB:</span>
                <span class="font-semibold text-gray-800"
                  ><%= patientDateOfBirth %></span
                >
              </p>
            </div>
            <% } %>

            <div class="flex flex-wrap gap-2 mb-3">
              <span
                class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium"
              >
                <i class="fas fa-database mr-1"></i>
                <%= containerName %>
              </span>
              <span
                class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-medium"
              >
                <i class="fas fa-folder-medical mr-1"></i>
                <%= folderName %>
              </span>
              <span
                class="bg-purple-100 text-purple-800 px-3 py-1 rounded-full text-sm font-medium"
              >
                <i class="fas fa-fingerprint mr-1"></i>
                Secure Device Verification
              </span>
            </div>

            <!-- Important Notice -->
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3">
              <div class="flex items-start">
                <i class="fas fa-eye text-yellow-600 text-lg mr-2 mt-0.5"></i>
                <div>
                  <p class="text-sm font-medium text-yellow-800">
                    View Only Access - Security Protected
                  </p>
                  <p class="text-sm text-yellow-700">
                    Files cannot be downloaded. Advanced device verification and
                    location tracking active.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Patient Medical Files Section -->
      <div class="bg-white rounded-xl shadow-lg overflow-hidden">
        <div class="bg-gradient-to-r from-green-500 to-blue-600 px-6 py-4">
          <div class="flex items-center justify-between text-white">
            <div class="flex items-center">
              <i class="fas fa-file-medical-alt text-2xl mr-3"></i>
              <div>
                <h2 class="text-xl font-bold">Patient Medical Files</h2>
                <% if (files && files.length > 0) { %>
                <p class="text-sm opacity-90">
                  <%= files.length %> file(s) available • Security protected
                </p>
                <% } else { %>
                <p class="text-sm opacity-90">No files found</p>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <div class="p-6">
          <!-- Safari iOS Notice -->
          <div
            id="safari-ios-notice"
            class="mb-4 p-3 bg-blue-50 border border-blue-200 rounded-lg"
            style="display: none"
          >
            <div class="flex items-start">
              <i class="fas fa-mobile-alt text-blue-600 mt-0.5 mr-2"></i>
              <div>
                <p class="text-sm font-medium text-blue-800">
                  iPhone/iPad Notice
                </p>
                <p class="text-sm text-blue-700">
                  Files will open in the same tab. Use the back button to
                  return.
                </p>
              </div>
            </div>
          </div>

          <% if (!files || files.length === 0) { %>
          <!-- No Files Message -->
          <div class="text-center py-12">
            <i class="fas fa-folder-open text-gray-300 text-6xl mb-4"></i>
            <h3 class="text-xl font-semibold text-gray-600 mb-2">
              No Medical Files Found
            </h3>
            <p class="text-gray-500">
              No files are available for this patient at this time.
            </p>
          </div>
          <% } else { %>
          <!-- Files List -->
          <div class="space-y-3">
            <% files.forEach(function(file, index) { %>
            <div
              class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm hover:shadow-md transition-all duration-200"
            >
              <button
                class="file-link w-full text-left"
                data-container="<%= containerName %>"
                data-folder="<%= folderName %>"
                data-filename="<%= encodeURIComponent(file.name) %>"
                title="Tap to open file"
              >
                <div class="flex items-start space-x-4">
                  <!-- File Icon -->
                  <div class="flex-shrink-0">
                    <% var fileIcon = 'fa-file text-gray-500'; var iconBg =
                    'bg-gray-100'; if (file.contentType) { if
                    (file.contentType.indexOf('image') !== -1) { fileIcon =
                    'fa-file-image text-green-600'; iconBg = 'bg-green-100'; }
                    else if (file.contentType.indexOf('pdf') !== -1) { fileIcon
                    = 'fa-file-pdf text-red-600'; iconBg = 'bg-red-100'; } else
                    if (file.contentType.indexOf('word') !== -1) { fileIcon =
                    'fa-file-word text-blue-600'; iconBg = 'bg-blue-100'; } else
                    if (file.contentType.indexOf('excel') !== -1) { fileIcon =
                    'fa-file-excel text-green-700'; iconBg = 'bg-green-100'; }
                    else if (file.contentType.indexOf('text') !== -1) { fileIcon
                    = 'fa-file-alt text-gray-600'; iconBg = 'bg-gray-100'; } }
                    %>
                    <div
                      class="<%= iconBg %> rounded-lg p-3 w-12 h-12 flex items-center justify-center"
                    >
                      <i class="fas <%= fileIcon %> text-lg"></i>
                    </div>
                  </div>

                  <!-- File Details -->
                  <div class="flex-1 min-w-0">
                    <h3
                      class="text-lg font-semibold text-blue-600 hover:text-blue-800 mb-2 break-words"
                    >
                      <%= file.name %>
                    </h3>
                    <div class="space-y-2">
                      <div
                        class="flex flex-wrap items-center gap-4 text-sm text-gray-600"
                      >
                        <div class="flex items-center">
                          <i class="fas fa-calendar-alt mr-2 text-gray-400"></i>
                          <span
                            ><%= new
                            Date(file.lastModified).toLocaleDateString()
                            %></span
                          >
                        </div>
                        <div class="flex items-center">
                          <i class="fas fa-file-alt mr-2 text-gray-400"></i>
                          <span><%= formatFileSize(file.contentLength) %></span>
                        </div>
                      </div>
                      <div class="flex items-center justify-between">
                        <div class="flex items-center">
                          <span
                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800"
                          >
                            <i class="fas fa-tag mr-1"></i>
                            <% if (file.contentType &&
                            file.contentType.indexOf('/') !== -1) { %> <%=
                            file.contentType.split('/')[1].toUpperCase() %> <% }
                            else { %> UNKNOWN <% } %>
                          </span>
                        </div>
                        <div
                          class="flex items-center text-blue-500 text-sm font-medium"
                        >
                          <i class="fas fa-hand-pointer mr-1"></i>
                          <span>Tap to open</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </button>
            </div>
            <% }); %>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Security Notice -->
      <div class="mt-6 bg-gray-50 border border-gray-200 rounded-xl p-4">
        <div class="flex items-center justify-center text-gray-600">
          <i class="fas fa-shield-alt mr-2"></i>
          <p class="text-sm font-medium">
            Secure Emergency Access • Device & Location Protected • CompassPoint
            Health PRMS
          </p>
        </div>
        <p class="text-center text-xs text-gray-500 mt-1">
          Advanced device fingerprinting and geolocation active • For
          assistance, contact emergency medical services
        </p>
      </div>

      <!-- Session Expired Modal -->
      <div
        id="expired-modal"
        class="fixed inset-0 z-50 hidden overflow-y-auto bg-black bg-opacity-75"
      >
        <div
          class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center"
        >
          <div
            class="bg-white rounded-xl shadow-2xl transform transition-all max-w-md w-full p-8"
          >
            <div
              class="w-16 h-16 mx-auto mb-4 bg-red-100 rounded-full flex items-center justify-center"
            >
              <i class="fas fa-clock text-red-600 text-2xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-gray-800 mb-4">
              Session Expired
            </h2>
            <p class="text-gray-600 mb-6">
              Your emergency access session has expired for security reasons.
              Please scan the SmartToken again to access patient data.
            </p>
            <div class="bg-red-50 rounded-lg p-4 mb-6">
              <p class="text-sm text-red-800">
                <i class="fas fa-shield-alt mr-2"></i>
                Emergency access sessions are limited to 5 minutes for patient
                privacy and security.
              </p>
            </div>
            <button
              onclick="closeExpiredModal()"
              class="bg-red-500 hover:bg-red-600 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200"
            >
              Close Window
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
            // Global variables
            const CONTAINER_NAME = "<%= containerName %>";
            const FOLDER_NAME = "<%= folderName %>";
            const PATIENT_NAME = "<%= patientName %>";
            const TOKEN_ID = "<%= tokenId %>";

            // Location tracking variables
            let locationData = {
              gps: null,
              ipLocation: null,
              best: null,
              hasGPS: false,
              hasIPLocation: false,
            };

            // API Configuration
            const getApiServerUrl = () => {
              const hostname = window.location.hostname;
              const isDevelopment =
                hostname === "localhost" ||
                hostname === "127.0.0.1" ||
                hostname.startsWith("192.168.") ||
                hostname.startsWith("10.");

              if (isDevelopment) {
                if (hostname.startsWith("192.168.") || hostname.startsWith("10.")) {
                  return `http://${hostname}:5000`;
                } else {
                  return "http://localhost:5000";
                }
              } else {
                return window.location.origin;
              }
            };

            const API_CONFIG = {
              baseURL: getApiServerUrl(),
            };

            // FingerprintJS Pro service instance
            let fpService = null;
            let fpjsInitialized = false;

            /**
             * Toggle location details visibility
             */
            function toggleLocationDetails() {
              const details = document.getElementById("location-details");
              const chevron = document.getElementById("location-chevron");

              if (details.classList.contains("expanded")) {
                details.classList.remove("expanded");
                chevron.classList.remove("fa-chevron-up");
                chevron.classList.add("fa-chevron-down");
              } else {
                details.classList.add("expanded");
                chevron.classList.remove("fa-chevron-down");
                chevron.classList.add("fa-chevron-up");
              }
            }

            /**
             * ✅ Enhanced GPS location function with better error handling
             */
            async function getGPSLocation() {
              return new Promise((resolve) => {
                if (!navigator.geolocation) {
                  console.log("📍 GPS not available in this browser");
                  resolve(null);
                  return;
                }

                const options = {
                  enableHighAccuracy: true,
                  timeout: 10000,
                  maximumAge: 300000, // 5 minutes
                };

                navigator.geolocation.getCurrentPosition(
                  (position) => {
                    const gpsData = {
                      latitude: position.coords.latitude,
                      longitude: position.coords.longitude,
                      accuracy: position.coords.accuracy,
                      timestamp: new Date().toISOString(),
                      source: "device_gps",
                      type: "gps",
                    };
                    console.log("📍 GPS coordinates obtained:", {
                      lat: gpsData.latitude.toFixed(6),
                      lng: gpsData.longitude.toFixed(6),
                      accuracy: Math.round(gpsData.accuracy) + "m",
                    });
                    resolve(gpsData);
                  },
                  (error) => {
                    console.warn("GPS error:", error.message);
                    console.warn("GPS error code:", error.code);
                    resolve(null);
                  },
                  options
                );
              });
            }

            /**
             * Update location display with comprehensive information
             */
            function updateLocationDisplay() {
              const locationContent = document.getElementById("location-content");
              const locationSection = document.getElementById("location-section");
              const gpsLocationDiv = document.getElementById("gps-location");
              const ipLocationDiv = document.getElementById("ip-location");
              const networkInfoDiv = document.getElementById("network-info");
              const accuracyDiv = document.getElementById("location-accuracy");

              let primaryLocation = locationData.gps || locationData.ipLocation;
              let statusClass = "";
              let mainLocationText = "";
              let iconClass = "";

              if (locationData.gps) {
                // GPS is available - highest priority
                mainLocationText = `GPS Location (±${Math.round(
                  locationData.gps.accuracy || 0
                )}m)`;
                iconClass = "fa-satellite text-green-400";
                statusClass = "location-success";
              } else if (locationData.ipLocation) {
                // IP location
                const city = locationData.ipLocation.city || "Unknown City";
                const region = locationData.ipLocation.region || "Unknown Region";
                const country = locationData.ipLocation.country || "Unknown Country";

                mainLocationText = `${city}, ${region}, ${country}`;
                iconClass = "fa-globe text-blue-400";
                statusClass = "location-warning";
              } else {
                // No location available
                mainLocationText = "Location unavailable";
                iconClass = "fa-question-circle text-red-400";
                statusClass = "location-error";
              }

              // Update main location display
              locationContent.innerHTML = `
                <div class="text-sm text-red-100">
                  <p class="font-medium">
                    <i class="fas ${iconClass} mr-1"></i>
                    ${mainLocationText}
                  </p>
                  <p class="text-xs text-red-200 mt-1">
                    ${
                      locationData.gps
                        ? "Device GPS"
                        : locationData.ipLocation
                        ? "IP Location Service"
                        : "No location data"
                    } •
                    Detected at ${new Date().toLocaleTimeString()}
                  </p>
                </div>
              `;

              // Update location section styling
              locationSection.classList.remove(
                "location-error",
                "location-warning",
                "location-success"
              );
              locationSection.classList.add(statusClass);

              // Update detailed information
              if (locationData.gps) {
                gpsLocationDiv.innerHTML = `
                  <i class="fas fa-satellite mr-1 text-green-300"></i>
                  <span>GPS: ${locationData.gps.latitude.toFixed(
                    6
                  )}, ${locationData.gps.longitude.toFixed(6)} (±${Math.round(
                  locationData.gps.accuracy
                )}m)</span>
                `;
              } else {
                gpsLocationDiv.innerHTML = `
                  <i class="fas fa-satellite mr-1"></i>
                  <span>GPS: Not available</span>
                `;
              }

              if (locationData.ipLocation) {
                const loc = locationData.ipLocation;
                const coordsDisplay =
                  loc.latitude && loc.longitude
                    ? ` (${loc.latitude.toFixed(4)}, ${loc.longitude.toFixed(4)})`
                    : "";

                ipLocationDiv.innerHTML = `
          <i class="fas fa-globe mr-1 text-blue-300"></i>
          <span>IP Location: ${loc.city}, ${loc.region}, ${loc.country}${coordsDisplay}</span>
        `;

                networkInfoDiv.innerHTML = `
          <i class="fas fa-network-wired mr-1"></i>
          <span>ISP: ${loc.org || "Unknown"} • IP: ${loc.ipAddress}</span>
        `;

                accuracyDiv.innerHTML = `
          <i class="fas fa-crosshairs mr-1"></i>
          <span>Timezone: ${loc.timezone || "Unknown"} • Source: ${loc.source}</span>
        `;
              } else {
                ipLocationDiv.innerHTML = `
                  <i class="fas fa-globe mr-1"></i>
                  <span>IP Location: Not available</span>
                `;
              }
            }

            /**
             * ROBUST Mobile FingerprintJS Pro Loading with Enhanced Location
             */
            async function loadFingerprintJSDirectlyRobust() {
              console.log("🌐 Loading FingerprintJS Pro with IP location support...");

              const maxRetries = 3;
