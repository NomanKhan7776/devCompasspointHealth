                tokenId: result.tokenId,
                isRegistered: result.isRegisteredDevice,
                alertsTriggered: result.alertsTriggered,
                deviceType: result.deviceInfo?.deviceType,
                locationData: !!result.locationData,
              });

              updateDeviceSection(fingerprint, result);

              if (result.isRegisteredDevice === false) {
                console.log("Server confirmed: Unregistered device");
                if (result.alertsTriggered === true) {
                  showSecurityNotice(
                    "Emergency contacts have been notified of this access from an unregistered device."
                  );
                } else {
                  showSecurityNotice(
                    "This device is not registered for this patient."
                  );
                }
              } else if (result.isRegisteredDevice === true) {
                console.log("Server confirmed: Registered device");
                hideSecurityNotice();
              } else {
                console.log("Server response: Device status unknown");
                showSecurityNotice("Device verification in progress...");
              }

              return result;
            } else {
              console.warn("Server returned success=false:", result.message);
              updateDeviceSection(fingerprint, {
                success: false,
                isRegisteredDevice: false,
                message: result.message,
              });
              return result;
            }
          } else {
            console.error(
              `Fingerprint request failed: ${response.status} ${response.statusText}`
            );

            let errorMessage = "Server communication failed";
            try {
              const errorData = await response.json();
              console.error("Server error details:", errorData);
              errorMessage = errorData.message || errorMessage;
            } catch (parseError) {
              console.error("Could not parse error response");
            }

            updateDeviceSection(fingerprint, {
              success: false,
              isRegisteredDevice: false,
              error: errorMessage,
            });

            showSecurityNotice("Device verification failed. Please try again.");

            return { success: false, error: errorMessage };
          }
        } catch (error) {
          console.error("Error sending fingerprint:", error);

          let errorMessage = "Network error occurred";
          let userFriendlyMessage =
            "Please check your internet connection and try again.";

          if (
            error.name === "AbortError" ||
            error.message.includes("timeout")
          ) {
            errorMessage = "Device verification timed out";
            userFriendlyMessage =
              "Verification is taking longer than expected. Please try refreshing the page.";
          } else if (error.message.includes("fetch")) {
            errorMessage = "Connection failed";
            userFriendlyMessage =
              "Unable to connect to the server. Please check your network connection.";
          } else if (error.message.includes("No working API server")) {
            errorMessage = "Server unavailable";
            userFriendlyMessage =
              "The medical server is currently unavailable. Please contact technical support.";
          }

          updateDeviceSection(fingerprint, {
            success: false,
            isRegisteredDevice: false,
            error: errorMessage,
            userMessage: userFriendlyMessage,
          });

          showSecurityNotice(`Network error: ${userFriendlyMessage}`);

          return { success: false, error: errorMessage };
        }
      }

      // Detect Safari iOS
      function isSafariIOS() {
        const userAgent = navigator.userAgent.toLowerCase();
        return (
          /iphone|ipad|ipod/.test(userAgent) &&
          /safari/.test(userAgent) &&
          !/chrome|crios|fxios|edgios/.test(userAgent)
        );
      }

      // Close expired modal function
      function closeExpiredModal() {
        try {
          window.close();
        } catch (e) {
          window.history.back();
        }
      }

      // File viewing function
      function viewFile(containerName, folderName, fileName) {
        if (window.isExpired) {
          alert("Session has expired. Please scan the SmartToken again.");
          return;
        }

        try {
          const viewUrl = `${API_CONFIG.baseURL}/patients/file/${containerName}/${folderName}/${fileName}/view`;
          console.log(`Opening file: ${viewUrl}`);

          if (isSafariIOS()) {
            window.location.href = viewUrl;
          } else {
            const newWindow = window.open(viewUrl, "_blank");
            if (!newWindow || newWindow.closed) {
              window.location.href = viewUrl;
            } else {
              showFileOpenFeedback(fileName, "new tab");
            }
          }
        } catch (error) {
          console.error("Error opening file:", error);
          alert("Error opening file. Please try again.");
        }
      }

      // Show user feedback
      function showFileOpenFeedback(fileName, method) {
        const notification = document.createElement("div");
        notification.className =
          "fixed top-4 right-4 bg-green-500 text-white px-4 py-3 rounded-lg shadow-lg z-50 transform transition-all duration-300";

        const shortName =
          fileName.length > 25 ? fileName.substring(0, 25) + "..." : fileName;
        const message =
          method === "new tab"
            ? `Opening ${shortName} in new tab`
            : `Opening ${shortName}`;

        notification.innerHTML = `
        <div class="flex items-center">
          <i class="fas fa-check-circle mr-2"></i>
          <span>${message}</span>
        </div>
      `;

        document.body.appendChild(notification);

        setTimeout(() => {
          if (notification.parentNode) {
            notification.parentNode.removeChild(notification);
          }
        }, 3000);
      }

      // Test API connection
      async function testApiConnection() {
        try {
          console.log(`Testing API connection to: ${API_CONFIG.baseURL}`);

          const response = await fetch(`${API_CONFIG.baseURL}/api/status`, {
            method: "GET",
            headers: {
              "Content-Type": "application/json",
            },
          });

          if (response.ok) {
            const status = await response.json();
            console.log("API server connection successful:", status.service);
            return true;
          } else {
            console.warn("API server responded with status:", response.status);
            return false;
          }
        } catch (error) {
          console.error("API server connection failed:", error);
          return false;
        }
      }

      // Main initialization
      document.addEventListener("DOMContentLoaded", async function () {
        console.log("Emergency Access Initialization");

        const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
        const isIOSSafari =
          /iPhone|iPad|iPod/i.test(navigator.userAgent) &&
          /Safari/i.test(navigator.userAgent) &&
          !/Chrome/i.test(navigator.userAgent);

        console.log("Device Detection:", {
          isMobile,
          isIOSSafari,
          userAgent: navigator.userAgent,
          screenSize: `${screen.width}x${screen.height}`,
          windowSize: `${window.innerWidth}x${window.innerHeight}`,
          pixelRatio: window.devicePixelRatio || 1,
        });

        // Network and API configuration
        console.log("Starting network diagnostics...");

        console.log("Emergency Access Configuration:", {
          currentOrigin: window.location.origin,
          currentHost: window.location.hostname,
          currentPort: window.location.port,
          apiBaseURL: API_CONFIG.baseURL,
          isDevelopment:
            API_CONFIG.baseURL.includes("localhost") ||
            API_CONFIG.baseURL.includes("192.168"),
          tokenId: TOKEN_ID,
          patient: PATIENT_NAME,
        });

        let apiConnectionSuccessful = false;
        try {
          console.log("Testing primary API connection...");
          const connectionTest = await API_CONFIG.testConnection();

          if (!connectionTest.success) {
            console.log(
              "Primary connection failed, searching for alternatives..."
            );
            const workingUrl = await API_CONFIG.findWorkingApiUrl();
            apiConnectionSuccessful = !!workingUrl;

            if (workingUrl) {
              console.log(`Found working API URL: ${workingUrl}`);
            } else {
              console.error("No working API URL found - limited functionality");
            }
          } else {
            apiConnectionSuccessful = true;
            console.log("Primary API connection successful");
          }
        } catch (error) {
          console.error("API connection test failed:", error);
          apiConnectionSuccessful = false;
        }

        if (!apiConnectionSuccessful) {
          showConnectionError();
        }

        // Load profile image
        try {
          console.log("Loading patient profile image...");
          loadProfileImage();
        } catch (error) {
          console.error("Profile image loading failed:", error);
        }

        // Safari iOS specific optimizations
        if (isIOSSafari) {
          console.log("Applying iOS Safari optimizations...");

          const notice = document.getElementById("safari-ios-notice");
          if (notice) {
            notice.style.display = "block";
          }

          const viewport = document.querySelector('meta[name="viewport"]');
          if (viewport) {
            viewport.setAttribute(
              "content",
              "width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
            );
          }

          document.body.style.webkitOverflowScrolling = "touch";
        }

        // Session management
        console.log("Initializing session management...");

        function displayLocalAccessTime() {
          const accessTimeElement = document.getElementById(
            "access-time-display"
          );
          if (accessTimeElement) {
            try {
              const accessTime = new Date("<%= accessTime %>");
              const localTimeString = accessTime.toLocaleString(undefined, {
                month: "short",
                day: "numeric",
                hour: "2-digit",
                minute: "2-digit",
                hour12: true,
              });
              accessTimeElement.textContent = `Access granted at ${localTimeString}`;
            } catch (error) {
              console.error("Error formatting access time:", error);
              accessTimeElement.textContent = "Emergency access active";
            }
          }
        }

        displayLocalAccessTime();

        // Location and device detection
        console.log("Starting location and device detection...");

        try {
          console.log("Requesting GPS location...");
          currentLocation = await getCurrentLocation();
          console.log("GPS location result:", !!currentLocation);
        } catch (error) {
          console.error("GPS location failed:", error);
          currentLocation = null;
        }

        try {
          console.log("Initializing device fingerprinting...");
          if (apiConnectionSuccessful) {
            deviceInfo = await initializeDeviceFingerprinting();
            console.log("Device fingerprinting result:", !!deviceInfo);
          } else {
            console.warn(
              "Skipping device fingerprinting due to API connection failure"
            );
            deviceInfo = generateFallbackFingerprint();
            updateDeviceSection(deviceInfo, {
              success: false,
              error: "Network connection unavailable",
              userMessage: "Device verification failed due to network issues",
            });
          }
        } catch (error) {
          console.error("Device fingerprinting failed:", error);
          deviceInfo = null;
        }

        // Session timer
        const SESSION_DURATION = 5 * 60; // 5 minutes
        let timeRemaining = SESSION_DURATION;
        let sessionTimer = null;
        window.isExpired = false;

        const timerElement = document.getElementById("session-timer");
        const expiredModal = document.getElementById("expired-modal");
        const fileLinks = document.querySelectorAll(".file-link");

        function formatTime(seconds) {
          const minutes = Math.floor(seconds / 60);
          const remainingSeconds = seconds % 60;
          return `${minutes}:${remainingSeconds.toString().padStart(2, "0")}`;
        }

        function updateTimer() {
          if (timerElement) {
            timerElement.textContent = formatTime(timeRemaining);

            if (timeRemaining <= 60) {
              timerElement.className =
                "text-2xl font-bold animate-pulse text-red-200";
            } else if (timeRemaining <= 120) {
              timerElement.className = "text-2xl font-bold text-yellow-200";
            } else {
              timerElement.className = "text-2xl font-bold";
            }
          }
        }

        function expireSession() {
          window.isExpired = true;

          if (sessionTimer) {
            clearInterval(sessionTimer);
          }

          fileLinks.forEach((link) => {
            link.classList.add(
              "opacity-50",
              "cursor-not-allowed",
              "bg-gray-400"
            );
            link.setAttribute("disabled", "true");
            link.onclick = function (e) {
              e.preventDefault();
              return false;
            };
          });

          if (expiredModal) {
            expiredModal.classList.remove("hidden");
          }

          console.log("Session expired");
        }

        function startSessionTimer() {
          updateTimer();
          sessionTimer = setInterval(() => {
            timeRemaining--;
            updateTimer();
            if (timeRemaining <= 0 && !window.isExpired) {
              expireSession();
            }
          }, 1000);
        }

        // File link event listeners
        const fileButtons = document.querySelectorAll(
          ".file-link[data-container]"
        );
        fileButtons.forEach((button) => {
          let touchStartTime = 0;

          button.addEventListener("touchstart", function () {
            touchStartTime = Date.now();
          });

          button.addEventListener("click", function (e) {
            e.preventDefault();

            const container = this.getAttribute("data-container");
            const folder = this.getAttribute("data-folder");
            const filename = this.getAttribute("data-filename");

            console.log("File access requested:", {
              container,
              folder,
              filename,
            });
            viewFile(container, folder, filename);
          });

          button.addEventListener("touchend", function (e) {
            const touchDuration = Date.now() - touchStartTime;

            if (touchDuration < 500) {
              const container = this.getAttribute("data-container");
              const folder = this.getAttribute("data-folder");
              const filename = this.getAttribute("data-filename");

              console.log("Mobile file access:", {
                container,
                folder,
                filename,
              });
              viewFile(container, folder, filename);
            }
          });
        });

        // Start the session timer
        startSessionTimer();

        // Mobile-specific navigation handling
        window.addEventListener("beforeunload", function (e) {
          if (window.isExpired) {
            e.preventDefault();
            e.returnValue =
              "Your session has expired. Please scan the SmartToken again.";
          }
        });

        // Network connectivity handling
        window.addEventListener("online", function () {
          console.log("Connection restored - retrying API connection");
          if (!apiConnectionSuccessful) {
            API_CONFIG.testConnection().then((result) => {
              if (result.success) {
                console.log("API connection restored");
                window.location.reload();
              }
            });
          }
        });

        window.addEventListener("offline", function () {
          console.log("Connection lost");
          showConnectionError("Internet connection lost");
        });

        console.log("Emergency access initialization complete");
      });

      // Connection error display
      function showConnectionError(message = "Network connection unavailable") {
        const errorDiv = document.createElement("div");
        errorDiv.className =
          "fixed top-0 left-0 right-0 bg-red-600 text-white p-3 text-center z-50";
        errorDiv.innerHTML = `
    <div class="flex items-center justify-center">
      <i class="fas fa-wifi mr-2"></i>
      <span>${message}</span>
      <button onclick="this.parentElement.parentElement.remove()" class="ml-4 text-white">
        <i class="fas fa-times"></i>
      </button>
    </div>
  `;
        document.body.insertBefore(errorDiv, document.body.firstChild);
      }

      console.log("Clean patient data interface loaded successfully");
    </script>
  </body>
</html>
