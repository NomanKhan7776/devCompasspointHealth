<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />
    <!-- Device Fingerprinting Service -->
    <script>
      // ✅ CRITICAL FIX: Dynamic script loading for mobile
      const hostname = window.location.hostname;
      let scriptUrl;

      if (hostname.startsWith("192.168.") || hostname.startsWith("10.")) {
        // Mobile device - use same IP as current page
        scriptUrl = `http://${hostname}:5000/js/deviceFingerprintingService.js`;
      } else if (hostname === "localhost" || hostname === "127.0.0.1") {
        // Desktop browser
        scriptUrl = "http://localhost:5000/js/deviceFingerprintingService.js";
      } else {
        // Production
        scriptUrl = `${window.location.origin}/js/deviceFingerprintingService.js`;
      }

      console.log("🔧 Loading fingerprinting service from:", scriptUrl);

      const script = document.createElement("script");
      script.src = scriptUrl;
      script.onload = () => console.log("✅ Fingerprinting service loaded");
      script.onerror = () =>
        console.error("❌ Failed to load fingerprinting service");
      document.head.appendChild(script);
    </script>
    <script src="https://cdn.jsdelivr.net/npm/eruda"></script>

    <!-- 🔧 ENHANCED MOBILE ERUDA INITIALIZATION -->
    <script>
      // Enhanced mobile detection and forced initialization
      console.log("🚀 Starting Enhanced Mobile Eruda Initialization...");

      const isMobile =
        /iPhone|iPad|iPod|Android|BlackBerry|Opera Mini|IEMobile|WPDesktop/i.test(
          navigator.userAgent
        );
      const isIOSSafari =
        /iPhone|iPad|iPod/i.test(navigator.userAgent) &&
        /Safari/i.test(navigator.userAgent) &&
        !/Chrome/i.test(navigator.userAgent);
      const isDevelopment =
        window.location.hostname === "localhost" ||
        window.location.hostname === "127.0.0.1" ||
        window.location.hostname.includes("192.168") ||
        window.location.hostname.includes("10.0");

      console.log("📱 Device Detection:", {
        isMobile: isMobile,
        isIOSSafari: isIOSSafari,
        isDevelopment: isDevelopment,
        userAgent: navigator.userAgent,
      });

      // Force initialize on mobile or development
      if (isMobile || isDevelopment) {
        try {
          eruda.init({
            container: document.body,
            tool: ["console", "elements", "network", "resources", "info"],
            useShadowDom: true,
            autoScale: true,
            defaults: {
              displaySize: isIOSSafari ? 45 : 50,
              theme: "Material Oceanic Next",
              transparency: 0.9,
            },
          });

          console.log("✅ Eruda initialized successfully for mobile");
          window.erudaInitialized = true;

          // Log initial medical debug info
          setTimeout(() => {
            logInitialMedicalDebug();
          }, 1000);
        } catch (error) {
          console.error("❌ Eruda initialization failed:", error);
          window.erudaInitialized = false;
        }
      }

      // 🏥 MEDICAL DEBUG LOGGING FUNCTION
      function logInitialMedicalDebug() {
        console.group("🏥 MEDICAL EMERGENCY ACCESS DEBUG");
        console.log("📱 Device Info:", {
          userAgent: navigator.userAgent,
          screenSize: `${screen.width}x${screen.height}`,
          viewportSize: `${window.innerWidth}x${window.innerHeight}`,
          pixelRatio: window.devicePixelRatio || 1,
          touchPoints: navigator.maxTouchPoints || 0,
          platform: navigator.platform,
          language: navigator.language,
          cookieEnabled: navigator.cookieEnabled,
          onLine: navigator.onLine,
          connection: navigator.connection
            ? {
                effectiveType: navigator.connection.effectiveType,
                downlink: navigator.connection.downlink,
                rtt: navigator.connection.rtt,
              }
            : "Not available",
        });

        console.log("🚨 Emergency Access Status:", {
          currentURL: window.location.href,
          timestamp: new Date().toISOString(),
          erudaActive: window.erudaInitialized || false,
        });

        console.groupEnd();
      }
    </script>

    <style>
      /* 🔧 ENHANCED ERUDA TOGGLE WITH FORCED VISIBILITY */
      .eruda-toggle {
        position: fixed !important;
        top: 15px !important;
        right: 15px !important;
        z-index: 99999 !important;
        background: linear-gradient(45deg, #ff6b6b, #4ecdc4) !important;
        color: white !important;
        border: none !important;
        border-radius: 50% !important;
        width: 60px !important;
        height: 60px !important;
        font-size: 24px !important;
        cursor: pointer !important;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4) !important;
        display: block !important; /* Force display */
        opacity: 1 !important;
        transform: scale(1) !important;
        transition: all 0.3s ease !important;
        touch-action: manipulation !important; /* Better touch response */
        -webkit-tap-highlight-color: transparent !important;
        pointer-events: auto !important;
        visibility: visible !important;
      }

      .eruda-toggle:hover,
      .eruda-toggle:active {
        transform: scale(1.1) !important;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.5) !important;
      }

      .eruda-toggle.active {
        background: linear-gradient(45deg, #4ecdc4, #45b7aa) !important;
        animation: pulse-debug 2s infinite !important;
      }

      @keyframes pulse-debug {
        0%,
        100% {
          transform: scale(1);
          box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
        }
        50% {
          transform: scale(1.05);
          box-shadow: 0 6px 25px rgba(78, 205, 196, 0.6);
        }
      }

      /* Alternative debug panel for when Eruda fails */
      .emergency-debug-panel {
        position: fixed;
        bottom: 20px;
        left: 20px;
        right: 20px;
        background: rgba(0, 0, 0, 0.95);
        color: #00ff00;
        padding: 15px;
        border-radius: 10px;
        font-family: "Courier New", monospace;
        font-size: 12px;
        max-height: 250px;
        overflow-y: auto;
        z-index: 99998;
        border: 2px solid #ff6b6b;
        display: none;
      }

      .emergency-debug-panel.active {
        display: block !important;
      }

      .debug-header {
        color: #ff6b6b;
        font-weight: bold;
        text-align: center;
        margin-bottom: 10px;
        border-bottom: 1px solid #ff6b6b;
        padding-bottom: 5px;
      }

      .debug-item {
        margin: 5px 0;
        padding: 2px 0;
      }

      .debug-label {
        color: #4ecdc4;
        font-weight: bold;
      }

      .debug-value {
        color: #ffffff;
        margin-left: 10px;
      }

      /* Mobile-specific adjustments */
      @media (max-width: 768px) {
        .eruda-toggle {
          top: 20px !important;
          right: 20px !important;
          width: 55px !important;
          height: 55px !important;
          font-size: 20px !important;
        }

        .emergency-debug-panel {
          bottom: 10px;
          left: 10px;
          right: 10px;
          font-size: 11px;
          max-height: 200px;
        }
      }

      .profile-image {
        width: 150px;
        height: 150px;
        border-radius: 12px;
        object-fit: cover;
        border: 3px solid #e5e7eb;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      }
      .profile-placeholder {
        width: 150px;
        height: 150px;
        border-radius: 12px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 3px solid #e5e7eb;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      }
      .profile-initials {
        font-size: 3rem;
        font-weight: bold;
        color: white;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
      }
      .location-badge {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255, 255, 255, 0.2);
      }

      .location-icon {
        animation: pulse 2s infinite;
      }

      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.05);
        }
      }

      .access-location {
        background: linear-gradient(
          45deg,
          rgba(255, 255, 255, 0.1),
          rgba(255, 255, 255, 0.05)
        );
        border-left: 4px solid rgba(255, 255, 255, 0.3);
      }

      .location-loading {
        display: inline-block;
        width: 20px;
        height: 20px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        border-top-color: #fff;
        animation: spin 1s ease-in-out infinite;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      @media (max-width: 640px) {
        .profile-image,
        .profile-placeholder {
          width: 120px;
          height: 120px;
        }
        .profile-initials {
          font-size: 2.5rem;
        }
      }
    </style>
  </head>
  <body class="bg-gray-100 min-h-screen">
    <div class="container mx-auto px-4 py-6 max-w-4xl">
      <!-- Emergency Access Banner -->
      <% if (typeof isEmergencyAccess !== 'undefined' && isEmergencyAccess) { %>
      <div class="bg-red-500 text-white p-4 mb-6 rounded-lg shadow-lg">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center">
            <i class="fas fa-shield-alt text-white text-2xl mr-3"></i>
            <div>
              <h2 class="text-xl font-bold">🚨 EMERGENCY ACCESS</h2>
              <p class="text-sm opacity-90">
                Secure medical data access •
                <span id="access-time-display"></span>
              </p>
            </div>
          </div>
          <!-- Session Timer -->
          <div class="text-right">
            <p class="text-sm font-medium">Session expires in:</p>
            <p id="session-timer" class="text-2xl font-bold">5:00</p>
          </div>
        </div>

        <!-- Location Information -->
        <div
          id="location-section"
          class="bg-red-600 bg-opacity-50 rounded-lg p-3 mb-3"
        >
          <div class="flex items-start space-x-3">
            <i class="fas fa-map-marker-alt text-white text-lg mt-1"></i>
            <div class="flex-1">
              <h3 class="text-sm font-semibold text-white mb-1">
                <i class="fas fa-location-arrow mr-1"></i>
                Access Location
              </h3>

              <!-- Dynamic location content will be inserted here -->
              <div id="location-content">
                <div class="text-sm text-red-100">
                  <p class="font-medium">
                    <span class="location-loading"></span>
                    <span class="ml-2">Detecting location...</span>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Device Information -->
        <div
          id="device-section"
          class="bg-red-600 bg-opacity-50 rounded-lg p-3"
        >
          <div class="flex items-start space-x-3">
            <i class="fas fa-desktop text-white text-lg mt-1"></i>
            <div class="flex-1">
              <h3 class="text-sm font-semibold text-white mb-1">
                <i class="fas fa-desktop mr-1"></i>
                Device Information
              </h3>
              <div id="device-content" class="text-sm text-red-100">
                <p class="font-medium">
                  <span class="location-loading"></span>
                  <span class="ml-2">Analyzing device...</span>
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Security Notice -->
        <div
          id="security-notice"
          class="mt-3 p-2 bg-red-700 bg-opacity-50 rounded-lg text-center"
          style="display: none"
        >
          <p class="text-xs text-red-100">
            <i class="fas fa-bell mr-1"></i>
            <span id="security-message"></span>
          </p>
        </div>
      </div>
      <% } %>

      <!-- 🔧 ENHANCED ERUDA TOGGLE WITH MULTIPLE ACCESS METHODS -->
      <button
        id="eruda-toggle"
        class="eruda-toggle"
        onclick="toggleEnhancedEruda()"
        title="Medical Debug Console"
      >
        🔧
      </button>

      <!-- 📊 ALTERNATIVE DEBUG PANEL -->
      <div id="emergency-debug-panel" class="emergency-debug-panel">
        <div class="debug-header">🏥 EMERGENCY DEBUG CONSOLE</div>
        <div id="debug-content"></div>
        <div style="text-align: center; margin-top: 10px">
          <button
            onclick="toggleDebugPanel()"
            style="
              background: #ff6b6b;
              color: white;
              border: none;
              padding: 5px 10px;
              border-radius: 5px;
            "
          >
            Close
          </button>
          <button
            onclick="refreshDebugInfo()"
            style="
              background: #4ecdc4;
              color: white;
              border: none;
              padding: 5px 10px;
              border-radius: 5px;
              margin-left: 5px;
            "
          >
            Refresh
          </button>
        </div>
      </div>

      <!-- Offline Mode Warning -->
      <% if (typeof isOfflineMode !== 'undefined' && isOfflineMode) { %>
      <div
        class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4 mb-6 rounded-r-lg shadow-sm"
      >
        <div class="flex items-center">
          <i class="fas fa-wifi text-yellow-500 text-xl mr-3"></i>
          <div>
            <p class="font-semibold">Limited Access Mode</p>
            <p class="text-sm"><%= warning %></p>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Patient Header Card with Profile Image -->
      <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center mb-4">
          <!-- Profile Image Section -->
          <div class="mb-4 sm:mb-0 sm:mr-6 flex-shrink-0">
            <div id="profile-image-container">
              <!-- Profile image will be loaded here via JavaScript -->
              <div class="profile-placeholder">
                <span class="profile-initials" id="patient-initials">
                  <% let safeName = (patientName && typeof patientName ===
                  'string') ? patientName : 'Unknown Patient'; let initials =
                  safeName.split(' ').map(function(n) { return
                  n.charAt(0).toUpperCase(); }).join('').substring(0, 2); %> <%=
                  initials %>
                </span>
              </div>
            </div>
          </div>

          <!-- Patient Information -->
          <div class="flex-1 min-w-0">
            <h1 class="text-3xl font-bold text-gray-800 mb-2">
              <%= patientName %>
            </h1>

            <!-- Patient Date of Birth -->
            <% if (typeof patientDateOfBirth !== 'undefined' &&
            patientDateOfBirth) { %>
            <div class="mb-3">
              <p class="text-lg text-gray-600">
                <i class="fas fa-calendar-day mr-2 text-blue-500"></i>
                <span class="font-medium">DOB:</span>
                <span class="font-semibold text-gray-800"
                  ><%= patientDateOfBirth %></span
                >
              </p>
            </div>
            <% } %>

            <div class="flex flex-wrap gap-2 mb-3">
              <span
                class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium"
              >
                <i class="fas fa-database mr-1"></i>
                <%= containerName %>
              </span>
              <span
                class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-medium"
              >
                <i class="fas fa-folder-medical mr-1"></i>
                <%= folderName %>
              </span>
            </div>

            <!-- Important Notice -->
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3">
              <div class="flex items-start">
                <i class="fas fa-eye text-yellow-600 text-lg mr-2 mt-0.5"></i>
                <div>
                  <p class="text-sm font-medium text-yellow-800">
                    View Only Access
                  </p>
                  <p class="text-sm text-yellow-700">
                    Files cannot be downloaded for security reasons
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Patient Medical Files Section -->
      <div class="bg-white rounded-xl shadow-lg overflow-hidden">
        <div class="bg-gradient-to-r from-green-500 to-blue-600 px-6 py-4">
          <div class="flex items-center justify-between text-white">
            <div class="flex items-center">
              <i class="fas fa-file-medical-alt text-2xl mr-3"></i>
              <div>
                <h2 class="text-xl font-bold">Patient Medical Files</h2>
                <% if (files && files.length > 0) { %>
                <p class="text-sm opacity-90">
                  <%= files.length %> file(s) available
                </p>
                <% } else { %>
                <p class="text-sm opacity-90">No files found</p>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <div class="p-6">
          <!-- Safari iOS Notice -->
          <div
            id="safari-ios-notice"
            class="mb-4 p-3 bg-blue-50 border border-blue-200 rounded-lg"
            style="display: none"
          >
            <div class="flex items-start">
              <i class="fas fa-mobile-alt text-blue-600 mt-0.5 mr-2"></i>
              <div>
                <p class="text-sm font-medium text-blue-800">
                  iPhone/iPad Notice
                </p>
                <p class="text-sm text-blue-700">
                  Files will open in the same tab. Use the back button to
                  return.
                </p>
              </div>
            </div>
          </div>

          <% if (!files || files.length === 0) { %>
          <!-- No Files Message -->
          <div class="text-center py-12">
            <i class="fas fa-folder-open text-gray-300 text-6xl mb-4"></i>
            <h3 class="text-xl font-semibold text-gray-600 mb-2">
              No Medical Files Found
            </h3>
            <p class="text-gray-500">
              No files are available for this patient at this time.
            </p>
          </div>
          <% } else { %>
          <!-- Files List -->
          <div class="space-y-3">
            <% files.forEach(function(file, index) { %>
            <div
              class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm hover:shadow-md transition-all duration-200"
            >
              <!-- File Card Content -->
              <button
                class="file-link w-full text-left"
                data-container="<%= containerName %>"
                data-folder="<%= folderName %>"
                data-filename="<%= encodeURIComponent(file.name) %>"
                title="Tap to open file"
              >
                <div class="flex items-start space-x-4">
                  <!-- File Icon -->
                  <div class="flex-shrink-0">
                    <% var fileIcon = 'fa-file text-gray-500'; var iconBg =
                    'bg-gray-100'; if (file.contentType) { if
                    (file.contentType.indexOf('image') !== -1) { fileIcon =
                    'fa-file-image text-green-600'; iconBg = 'bg-green-100'; }
                    else if (file.contentType.indexOf('pdf') !== -1) { fileIcon
                    = 'fa-file-pdf text-red-600'; iconBg = 'bg-red-100'; } else
                    if (file.contentType.indexOf('word') !== -1) { fileIcon =
                    'fa-file-word text-blue-600'; iconBg = 'bg-blue-100'; } else
                    if (file.contentType.indexOf('excel') !== -1) { fileIcon =
                    'fa-file-excel text-green-700'; iconBg = 'bg-green-100'; }
                    else if (file.contentType.indexOf('text') !== -1) { fileIcon
                    = 'fa-file-alt text-gray-600'; iconBg = 'bg-gray-100'; } }
                    %>
                    <div
                      class="<%= iconBg %> rounded-lg p-3 w-12 h-12 flex items-center justify-center"
                    >
                      <i class="fas <%= fileIcon %> text-lg"></i>
                    </div>
                  </div>

                  <!-- File Details -->
                  <div class="flex-1 min-w-0">
                    <!-- File Name -->
                    <h3
                      class="text-lg font-semibold text-blue-600 hover:text-blue-800 mb-2 break-words"
                    >
                      <%= file.name %>
                    </h3>

                    <!-- File Metadata -->
                    <div class="space-y-2">
                      <!-- Date and Size Row -->
                      <div
                        class="flex flex-wrap items-center gap-4 text-sm text-gray-600"
                      >
                        <div class="flex items-center">
                          <i class="fas fa-calendar-alt mr-2 text-gray-400"></i>
                          <span
                            ><%= new
                            Date(file.lastModified).toLocaleDateString()
                            %></span
                          >
                        </div>
                        <div class="flex items-center">
                          <i class="fas fa-file-alt mr-2 text-gray-400"></i>
                          <span><%= formatFileSize(file.contentLength) %></span>
                        </div>
                      </div>

                      <!-- File Type and Action Row -->
                      <div class="flex items-center justify-between">
                        <div class="flex items-center">
                          <span
                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800"
                          >
                            <i class="fas fa-tag mr-1"></i>
                            <% if (file.contentType &&
                            file.contentType.indexOf('/') !== -1) { %> <%=
                            file.contentType.split('/')[1].toUpperCase() %> <% }
                            else { %> UNKNOWN <% } %>
                          </span>
                        </div>
                        <div
                          class="flex items-center text-blue-500 text-sm font-medium"
                        >
                          <i class="fas fa-hand-pointer mr-1"></i>
                          <span>Tap to open</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </button>
            </div>
            <% }); %>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Security Notice -->
      <div class="mt-6 bg-gray-50 border border-gray-200 rounded-xl p-4">
        <div class="flex items-center justify-center text-gray-600">
          <i class="fas fa-shield-alt mr-2"></i>
          <p class="text-sm font-medium">
            Secure Emergency Access • CompassPoint Health PRMS
          </p>
        </div>
        <p class="text-center text-xs text-gray-500 mt-1">
          For assistance, contact emergency medical services or facility
          administrator
        </p>
      </div>

      <!-- Session Expired Modal -->
      <div
        id="expired-modal"
        class="fixed inset-0 z-50 hidden overflow-y-auto bg-black bg-opacity-75"
      >
        <div
          class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center"
        >
          <div
            class="bg-white rounded-xl shadow-2xl transform transition-all max-w-md w-full p-8"
          >
            <div
              class="w-16 h-16 mx-auto mb-4 bg-red-100 rounded-full flex items-center justify-center"
            >
              <i class="fas fa-clock text-red-600 text-2xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-gray-800 mb-4">
              Session Expired
            </h2>
            <p class="text-gray-600 mb-6">
              Your emergency access session has expired for security reasons.
              Please scan the SmartToken again to access patient data.
            </p>
            <div class="bg-red-50 rounded-lg p-4 mb-6">
              <p class="text-sm text-red-800">
                <i class="fas fa-shield-alt mr-2"></i>
                Emergency access sessions are limited to 5 minutes for patient
                privacy and security.
              </p>
            </div>
            <button
              onclick="closeExpiredModal()"
              class="bg-red-500 hover:bg-red-600 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200"
            >
              Close Window
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Global variables
      const CONTAINER_NAME = "<%= containerName %>";
      const FOLDER_NAME = "<%= folderName %>";
      const PATIENT_NAME = "<%= patientName %>";
      const TOKEN_ID = "<%= tokenId %>";

      // ✅ FIX: Dynamic API server URL configuration
