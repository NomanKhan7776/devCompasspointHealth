<!-- views/patientData.ejs - IMPROVED UI FOR EMERGENCY ACCESS -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />
  </head>
  <body class="bg-gray-100 min-h-screen">
    <div class="container mx-auto px-4 py-6 max-w-4xl">
      <!-- Emergency Access Banner -->
      <% if (typeof isEmergencyAccess !== 'undefined' && isEmergencyAccess) { %>
      <div class="bg-red-500 text-white p-4 mb-6 rounded-lg shadow-lg">
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <i class="fas fa-shield-alt text-white text-2xl mr-3"></i>
            <div>
              <h2 class="text-xl font-bold">🚨 EMERGENCY ACCESS</h2>
              <p class="text-sm opacity-90">
                Secure medical data access •
                <span id="access-time-display"></span>
              </p>
            </div>
          </div>
          <!-- Session Timer -->
          <div class="text-right">
            <p class="text-sm font-medium">Session expires in:</p>
            <p id="session-timer" class="text-2xl font-bold">5:00</p>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Offline Mode Warning -->
      <% if (typeof isOfflineMode !== 'undefined' && isOfflineMode) { %>
      <div
        class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4 mb-6 rounded-r-lg shadow-sm"
      >
        <div class="flex items-center">
          <i class="fas fa-wifi text-yellow-500 text-xl mr-3"></i>
          <div>
            <p class="font-semibold">Limited Access Mode</p>
            <p class="text-sm"><%= warning %></p>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Patient Header Card -->
      <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
        <div class="flex items-center mb-4">
          <div class="bg-blue-100 rounded-full p-3 mr-4">
            <i class="fas fa-user-injured text-blue-600 text-2xl"></i>
          </div>
          <div class="flex-1">
            <h1 class="text-3xl font-bold text-gray-800 mb-2">
              <%= patientName %>
            </h1>
            <div class="flex flex-wrap gap-2">
              <span
                class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium"
              >
                <i class="fas fa-database mr-1"></i>
                <%= containerName %>
              </span>
              <span
                class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-medium"
              >
                <i class="fas fa-folder-medical mr-1"></i>
                <%= folderName %>
              </span>
            </div>
          </div>
        </div>

        <!-- Important Notice -->
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3">
          <div class="flex items-start">
            <i class="fas fa-eye text-yellow-600 text-lg mr-2 mt-0.5"></i>
            <div>
              <p class="text-sm font-medium text-yellow-800">
                View Only Access
              </p>
              <p class="text-sm text-yellow-700">
                Files cannot be downloaded for security reasons
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Patient Medical Files Section -->
      <div class="bg-white rounded-xl shadow-lg overflow-hidden">
        <div class="bg-gradient-to-r from-green-500 to-blue-600 px-6 py-4">
          <div class="flex items-center justify-between text-white">
            <div class="flex items-center">
              <i class="fas fa-file-medical-alt text-2xl mr-3"></i>
              <div>
                <h2 class="text-xl font-bold">Patient Medical Files</h2>
                <% if (files && files.length > 0) { %>
                <p class="text-sm opacity-90">
                  <%= files.length %> file(s) available
                </p>
                <% } else { %>
                <p class="text-sm opacity-90">No files found</p>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <div class="p-6">
          <!-- Safari iOS Notice -->
          <div
            id="safari-ios-notice"
            class="mb-4 p-3 bg-blue-50 border border-blue-200 rounded-lg"
            style="display: none"
          >
            <div class="flex items-start">
              <i class="fas fa-mobile-alt text-blue-600 mt-0.5 mr-2"></i>
              <div>
                <p class="text-sm font-medium text-blue-800">
                  iPhone/iPad Notice
                </p>
                <p class="text-sm text-blue-700">
                  Files will open in the same tab. Use the back button to
                  return.
                </p>
              </div>
            </div>
          </div>

          <% if (!files || files.length === 0) { %>
          <!-- No Files Message -->
          <div class="text-center py-12">
            <i class="fas fa-folder-open text-gray-300 text-6xl mb-4"></i>
            <h3 class="text-xl font-semibold text-gray-600 mb-2">
              No Medical Files Found
            </h3>
            <p class="text-gray-500">
              No files are available for this patient at this time.
            </p>
          </div>
          <% } else { %>
          <!-- Files Grid -->
          <div class="grid gap-4">
            <% files.forEach(function(file, index) { %>
            <div
              class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-all duration-200"
            >
              <div class="flex items-center justify-between">
                <div class="flex items-center flex-1">
                  <!-- File Icon -->
                  <div class="flex-shrink-0 mr-4">
                    <% let fileIcon = 'fa-file text-gray-500'; let iconBg =
                    'bg-gray-100'; if (file.contentType) { if
                    (file.contentType.includes('image')) { fileIcon =
                    'fa-file-image text-green-600'; iconBg = 'bg-green-100'; }
                    else if (file.contentType.includes('pdf')) { fileIcon =
                    'fa-file-pdf text-red-600'; iconBg = 'bg-red-100'; } else if
                    (file.contentType.includes('word')) { fileIcon =
                    'fa-file-word text-blue-600'; iconBg = 'bg-blue-100'; } else
                    if (file.contentType.includes('excel')) { fileIcon =
                    'fa-file-excel text-green-700'; iconBg = 'bg-green-100'; } }
                    %>
                    <div class="<%= iconBg %> rounded-lg p-3">
                      <i class="fas <%= fileIcon %> text-xl"></i>
                    </div>
                  </div>

                  <!-- File Info -->
                  <div class="flex-1 min-w-0">
                    <button
                      class="file-link text-left w-full hover:bg-blue-50 p-2 rounded-lg transition-colors duration-200"
                      data-container="<%= containerName %>"
                      data-folder="<%= folderName %>"
                      data-filename="<%= encodeURIComponent(file.name) %>"
                      title="Tap to open file"
                    >
                      <h4
                        class="text-lg font-medium text-blue-600 hover:text-blue-800 truncate mb-1 underline"
                      >
                        <%= file.name %>
                      </h4>
                      <div
                        class="flex flex-wrap items-center gap-3 text-sm text-gray-500"
                      >
                        <span>
                          <i class="fas fa-calendar mr-1"></i>
                          <%= new Date(file.lastModified).toLocaleDateString()
                          %>
                        </span>
                        <span>
                          <i class="fas fa-weight-hanging mr-1"></i>
                          <% function formatFileSize(bytes) { if (bytes === 0)
                          return "0 Bytes"; const k = 1024; const sizes =
                          ["Bytes", "KB", "MB", "GB"]; const i =
                          Math.floor(Math.log(bytes) / Math.log(k)); return
                          parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + " "
                          + sizes[i]; } %> <%=
                          formatFileSize(file.contentLength) %>
                        </span>
                        <span
                          class="px-2 py-1 bg-gray-100 text-gray-700 rounded-full text-xs"
                        >
                          <%= file.contentType || 'Unknown' %>
                        </span>
                      </div>
                      <p class="text-xs text-blue-500 mt-1">
                        <i class="fas fa-hand-pointer mr-1"></i>
                        Tap to open file
                      </p>
                    </button>
                  </div>
                </div>

                <!-- File Type Badge -->
                <div class="flex-shrink-0 ml-4">
                  <div
                    class="bg-gray-100 text-gray-600 px-3 py-2 rounded-lg text-sm font-medium"
                  >
                    <i class="fas fa-eye mr-1"></i>
                    <span class="hidden sm:inline">View Only</span>
                    <span class="sm:hidden">View</span>
                  </div>
                </div>
              </div>
            </div>
            <% }); %>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Security Notice -->
      <div class="mt-6 bg-gray-50 border border-gray-200 rounded-xl p-4">
        <div class="flex items-center justify-center text-gray-600">
          <i class="fas fa-shield-alt mr-2"></i>
          <p class="text-sm font-medium">
            Secure Emergency Access • CompassPoint Health PRMS
          </p>
        </div>
        <p class="text-center text-xs text-gray-500 mt-1">
          For assistance, contact emergency medical services or facility
          administrator
        </p>
      </div>

      <!-- Session Expired Modal -->
      <div
        id="expired-modal"
        class="fixed inset-0 z-50 hidden overflow-y-auto bg-black bg-opacity-75"
      >
        <div
          class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center"
        >
          <div
            class="bg-white rounded-xl shadow-2xl transform transition-all max-w-md w-full p-8"
          >
            <div
              class="w-16 h-16 mx-auto mb-4 bg-red-100 rounded-full flex items-center justify-center"
            >
              <i class="fas fa-clock text-red-600 text-2xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-gray-800 mb-4">
              Session Expired
            </h2>
            <p class="text-gray-600 mb-6">
              Your emergency access session has expired for security reasons.
              Please scan the SmartToken again to access patient data.
            </p>
            <div class="bg-red-50 rounded-lg p-4 mb-6">
              <p class="text-sm text-red-800">
                <i class="fas fa-shield-alt mr-2"></i>
                Emergency access sessions are limited to 5 minutes for patient
                privacy and security.
              </p>
            </div>
            <button
              onclick="closeExpiredModal()"
              class="bg-red-500 hover:bg-red-600 text-white px-6 py-3 rounded-lg font-medium transition-colors duration-200"
            >
              Close Window
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Detect Safari iOS
      function isSafariIOS() {
        const userAgent = navigator.userAgent.toLowerCase();
        return (
          /iphone|ipad|ipod/.test(userAgent) &&
          /safari/.test(userAgent) &&
          !/chrome|crios|fxios|edgios/.test(userAgent)
        );
      }

      // Close expired modal function
      function closeExpiredModal() {
        try {
          window.close();
        } catch (e) {
          window.history.back();
        }
      }

      // Universal file viewer function
      function viewFile(containerName, folderName, fileName) {
        if (window.isExpired) {
          alert("Session has expired. Please scan the SmartToken again.");
          return;
        }

        try {
          const viewUrl = `/patients/file/${containerName}/${folderName}/${fileName}/view`;

          if (isSafariIOS()) {
            window.location.href = viewUrl;
          } else {
            const newWindow = window.open(viewUrl, "_blank");
            if (!newWindow || newWindow.closed) {
              window.location.href = viewUrl;
            } else {
              showFileOpenFeedback(fileName, "new tab");
            }
          }
        } catch (error) {
          console.error("Error opening file:", error);
          alert("Error opening file. Please try again.");
        }
      }

      // Show user feedback
      function showFileOpenFeedback(fileName, method) {
        const notification = document.createElement("div");
        notification.className =
          "fixed top-4 right-4 bg-green-500 text-white px-4 py-3 rounded-lg shadow-lg z-50 transform transition-all duration-300";

        const shortName =
          fileName.length > 25 ? fileName.substring(0, 25) + "..." : fileName;
        const message =
          method === "new tab"
            ? `Opening ${shortName} in new tab`
            : `Opening ${shortName}`;

        notification.innerHTML = `
          <div class="flex items-center">
            <i class="fas fa-check-circle mr-2"></i>
            <span>${message}</span>
          </div>
        `;

        document.body.appendChild(notification);

        setTimeout(() => {
          if (notification.parentNode) {
            notification.parentNode.removeChild(notification);
          }
        }, 3000);
      }

      document.addEventListener("DOMContentLoaded", function () {
        // Update UI for Safari iOS
        if (isSafariIOS()) {
          const notice = document.getElementById("safari-ios-notice");
          if (notice) {
            notice.style.display = "block";
          }
        }

        // Display access time in user's local timezone
        function displayLocalAccessTime() {
          const accessTimeElement = document.getElementById(
            "access-time-display"
          );
          if (accessTimeElement) {
            const accessTime = new Date("<%= accessTime %>");
            const localTimeString = accessTime.toLocaleString(undefined, {
              month: "short",
              day: "numeric",
              hour: "2-digit",
              minute: "2-digit",
              hour12: true,
            });
            accessTimeElement.textContent = `Access granted at ${localTimeString}`;
          }
        }

        // Session timer setup
        const SESSION_DURATION = 5 * 60; // 5 minutes
        let timeRemaining = SESSION_DURATION;
        let sessionTimer = null;
        window.isExpired = false;

        const timerElement = document.getElementById("session-timer");
        const expiredModal = document.getElementById("expired-modal");
        const fileLinks = document.querySelectorAll(".file-link");

        function formatTime(seconds) {
          const minutes = Math.floor(seconds / 60);
          const remainingSeconds = seconds % 60;
          return `${minutes}:${remainingSeconds.toString().padStart(2, "0")}`;
        }

        function updateTimer() {
          if (timerElement) {
            timerElement.textContent = formatTime(timeRemaining);

            if (timeRemaining <= 60) {
              timerElement.className = "text-2xl font-bold animate-pulse";
            } else if (timeRemaining <= 120) {
              timerElement.className = "text-2xl font-bold text-yellow-200";
            } else {
              timerElement.className = "text-2xl font-bold";
            }
          }
        }

        function expireSession() {
          window.isExpired = true;

          if (sessionTimer) {
            clearInterval(sessionTimer);
          }

          fileLinks.forEach((link) => {
            link.classList.add(
              "opacity-50",
              "cursor-not-allowed",
              "bg-gray-400"
            );
            link.setAttribute("disabled", "true");
            link.onclick = function (e) {
              e.preventDefault();
              return false;
            };
          });

          if (expiredModal) {
            expiredModal.classList.remove("hidden");
          }
        }

        function startSessionTimer() {
          updateTimer();
          sessionTimer = setInterval(() => {
            timeRemaining--;
            updateTimer();
            if (timeRemaining <= 0 && !window.isExpired) {
              expireSession();
            }
          }, 1000);
        }

        // Initialize
        displayLocalAccessTime();

        // Add event listeners to file buttons
        const fileButtons = document.querySelectorAll(
          ".file-link[data-container]"
        );
        fileButtons.forEach((button) => {
          button.addEventListener("click", function () {
            const container = this.getAttribute("data-container");
            const folder = this.getAttribute("data-folder");
            const filename = this.getAttribute("data-filename");
            viewFile(container, folder, filename);
          });
        });

        startSessionTimer();

        // Prevent navigation after expiry
        window.addEventListener("beforeunload", function (e) {
          if (window.isExpired) {
            e.preventDefault();
            e.returnValue =
              "Your session has expired. Please scan the SmartToken again.";
          }
        });
      });
    </script>
  </body>
</html>
