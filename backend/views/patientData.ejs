                      locationSource: ipLocation ? "fingerprintjs_pro" : "none",
                    },
                  };
                } catch (error) {
                  console.error("❌ Fingerprint generation failed:", error);
                  throw error;
                }
              },

              isAvailable() {
                return this.initialized && this.fpInstance !== null;
              },
            };

            window.FingerprintJS = FingerprintJS;
            window.fingerprintService = mobileFingerprintService;
            window.FingerprintJSBrowser = function () {
