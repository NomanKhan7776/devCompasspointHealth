      // 🔧 ENHANCED FINGERPRINT SERVICE FIX FOR IOS SAFARI
      class FixedDeviceFingerprintingService {
        constructor() {
          this.isIOSSafari =
            /iPhone|iPad|iPod/i.test(navigator.userAgent) &&
            /Safari/i.test(navigator.userAgent) &&
            !/Chrome/i.test(navigator.userAgent);
          this.isMobile = /Mobile|Android|iPhone|iPad|iPod/i.test(
            navigator.userAgent
          );

          // Cache stable values that never change
          this.stableCache = {
            userAgent: navigator.userAgent,
            language: navigator.language || "en-US",
            platform: navigator.platform || "unknown",
            cookieEnabled: navigator.cookieEnabled,
            hardwareConcurrency: navigator.hardwareConcurrency || 0,
            maxTouchPoints: navigator.maxTouchPoints || 0,

            // Screen values (stable)
            screenWidth: screen.width,
            screenHeight: screen.height,
            screenColorDepth: screen.colorDepth,
            screenAvailWidth: screen.availWidth,
            screenAvailHeight: screen.availHeight,

            // Stable display info
            pixelRatio: Math.round((window.devicePixelRatio || 1) * 100) / 100,

            // Timezone (stable)
            timezoneOffset: new Date().getTimezoneOffset(),
            timezone: this.getStableTimezone(),

            // Device type detection
            isAndroid: /Android/i.test(navigator.userAgent),
            isMobile: this.isMobile,
            isIOSSafari: this.isIOSSafari,
          };
        }

        getStableTimezone() {
          try {
            return Intl.DateTimeFormat().resolvedOptions().timeZone;
          } catch (e) {
            return "UTC";
          }
        }

        // Generate ONLY stable components for iOS Safari
        async generateStableFingerprint() {
          const components = {
            // Core stable components only
            ...this.stableCache,

            // Method identifier
            method: this.isIOSSafari
              ? "ios_safari_stable_v7"
              : this.isMobile
              ? "mobile_stable_v7"
              : "desktop_stable_v7",
          };

          // Create deterministic hash from stable components only
          const orderedKeys = Object.keys(components).sort();
          const stableString = orderedKeys
            .map((key) => {
              const value = components[key];
              return `${key}:${value}`;
            })
            .join("|");

          const hash = this.createStableHash(stableString);

          console.log("🔧 Generated stable fingerprint:", {
            hash: hash,
            method: components.method,
            componentCount: orderedKeys.length,
            isIOSSafari: this.isIOSSafari,
          });

          return {
            hash: hash,
            details: components,
            metadata: {
              deviceName: this.getDeviceName(),
              browserName: this.getBrowserName(),
              osName: this.getOSName(),
              deviceType: this.isMobile ? "mobile" : "desktop",
              method: components.method,
              isStable: true,
              version: "v7_stable",
            },
          };
        }

        createStableHash(str) {
          let hash = 0;
          if (str.length === 0) return hash.toString(16);

          for (let i = 0; i < str.length; i++) {
            const char = str.charCodeAt(i);
            hash = (hash << 5) - hash + char;
            hash = hash & hash; // Convert to 32bit integer
          }

          return Math.abs(hash).toString(16);
        }

        getDeviceName() {
          if (/iPhone/i.test(navigator.userAgent)) return "iPhone";
          if (/iPad/i.test(navigator.userAgent)) return "iPad";
          if (/Android/i.test(navigator.userAgent)) return "Android Device";
          if (/Mac/i.test(navigator.userAgent)) return "Mac";
          if (/Windows/i.test(navigator.userAgent)) return "Windows PC";
          return "Unknown Device";
        }

        getBrowserName() {
          if (this.isIOSSafari) return "Safari";
          if (/Chrome/i.test(navigator.userAgent)) return "Chrome";
          if (/Firefox/i.test(navigator.userAgent)) return "Firefox";
          if (/Edge/i.test(navigator.userAgent)) return "Edge";
          return "Unknown Browser";
        }

        getOSName() {
          if (/iPhone|iPad/i.test(navigator.userAgent)) return "iOS";
          if (/Android/i.test(navigator.userAgent)) return "Android";
          if (/Mac OS X/i.test(navigator.userAgent)) return "macOS";
          if (/Windows/i.test(navigator.userAgent)) return "Windows";
          return "Unknown OS";
        }
      }

      // 🚀 RUN DIAGNOSTIC AND TEST FIX
      async function runFingerprintDiagnostic() {
        console.log("🔍 Starting fingerprint diagnostic...");

        // Test current service consistency
        const currentResult = await debugFingerprintConsistency();

        if (currentResult && !currentResult.isConsistent) {
          console.log("🔧 Testing fixed fingerprinting service...");

          // Test fixed service
          const fixedService = new FixedDeviceFingerprintingService();
          const fixedFingerprints = [];

          for (let i = 0; i < 3; i++) {
            const fp = await fixedService.generateStableFingerprint();
            fixedFingerprints.push(fp.hash);
            console.log(`Fixed attempt ${i + 1}: ${fp.hash}`);
          }

          const fixedUnique = [...new Set(fixedFingerprints)];
          console.log(
            "🔧 Fixed service consistency:",
            fixedUnique.length === 1 ? "CONSISTENT" : "INCONSISTENT"
          );
        }
      }

      // 📱 AUTO-RUN ON MOBILE
      if (/iPhone|iPad|iPod/i.test(navigator.userAgent)) {
        document.addEventListener("DOMContentLoaded", () => {
          setTimeout(() => {
            console.log("📱 Auto-running iOS Safari fingerprint diagnostic...");
            runFingerprintDiagnostic();
          }, 2000);
        });
      }

      // Make functions available globally for manual testing
      window.debugFingerprintConsistency = debugFingerprintConsistency;
      window.runFingerprintDiagnostic = runFingerprintDiagnostic;
      window.FixedDeviceFingerprintingService =
        FixedDeviceFingerprintingService;

      console.log(
        "🔧 Diagnostics available: window.diagnostics.checkEruda(), window.diagnostics.forceShowEruda(), window.diagnostics.showAlternativeDebug()"
      );
    </script>
  </body>
</html>
