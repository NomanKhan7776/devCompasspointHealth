                );
                const fingerprint = await fpService.generateFingerprint({
                  tag: "emergency_smarttoken_access",
                  linkedId: TOKEN_ID,
                });

                if (!fingerprint || !fingerprint.visitorId) {
                  throw new Error("Invalid fingerprint - no visitor ID generated");
                }

                console.log("✅ Enhanced fingerprint generated");

                // ✅ Get IP location from server
                console.log("🌍 Requesting IP location from server...");
                try {
                  const ipLocationResponse = await fetch(
                    `${API_CONFIG.baseURL}/api/ip-location`,
                    {
                      method: "GET",
                      headers: {
                        "Content-Type": "application/json",
                      },
                    }
                  );

                  if (ipLocationResponse.ok) {
                    const ipLocationResult = await ipLocationResponse.json();
                    if (ipLocationResult.success && ipLocationResult.location) {
                      locationData.ipLocation = ipLocationResult.location;
                      locationData.hasIPLocation = true;
                      console.log("✅ IP location obtained from server");
                    }
                  }
                } catch (ipError) {
                  console.warn(
                    "⚠️ Failed to get IP location from server:",
                    ipError.message
                  );
                }

                // Update location display
                updateLocationDisplay();

                // ✅ CRITICAL: Include BOTH GPS coordinates and location data in the payload
                const verificationPayload = {
                  deviceFingerprint: fingerprint,
                  gpsCoordinates: gpsCoordinates, // ✅ GPS coordinates
                  locationData: {
                    gps: locationData.gps,
                    ipLocation: locationData.ipLocation,
                    best: locationData.gps || locationData.ipLocation, // GPS priority
                    hasGPS: locationData.hasGPS,
                    hasIP: locationData.hasIPLocation,
                  },
                  hasLocationData: !!(locationData.gps || locationData.ipLocation),
                  locationSources: {
                    gps: locationData.hasGPS,
                    ipLocation: locationData.hasIPLocation,
                  },
                  extendedData: {
                    ipInfo: fingerprint.ipInfo,
                    botd: fingerprint.botd,
                    vpn: fingerprint.vpn,
                  },
                };

                console.log(
                  "📤 Sending enhanced verification with location to server...",
                  {
                    visitorId: fingerprint.visitorId,
                    confidence: fingerprint.confidence,
                    hasGPS: !!gpsCoordinates,
                    hasLocation: verificationPayload.hasLocationData,
                    gpsAccuracy: gpsCoordinates?.accuracy,
                    primaryLocation: locationData.gps ? "GPS" : "IP",
                  }
                );

                const verifyUrl = `${API_CONFIG.baseURL}/patients/verify/${TOKEN_ID}`;
                const response = await fetch(verifyUrl, {
                  method: "POST",
                  headers: {
                    "Content-Type": "application/json",
                  },
                  body: JSON.stringify(verificationPayload),
                });

                if (!response.ok) {
                  throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }

                const result = await response.json();

                if (result.success) {
                  console.log("✅ Enhanced device verification successful:", {
                    visitorId: result.visitorId,
                    isRegistered: result.isRegisteredDevice,
                    alertsTriggered: result.alertsTriggered,
                    confidence: result.confidence,
                    locationIncluded: !!(gpsCoordinates || locationData.ipLocation),
                  });

                  updateDeviceStatus(fingerprint, result);
                } else {
                  console.error("❌ Device verification failed:", result.message);
                  updateDeviceStatus(fingerprint, {
                    success: false,
                    error: result.message,
                    service: result.service || "fingerprintjs_pro",
                  });
                }

                return result;
              } catch (error) {
                console.error("❌ Enhanced device verification failed:", error);
                updateLocationDisplay(); // Still update location display with whatever we have
                updateDeviceStatus(null, {
                  success: false,
                  error: error.message,
                  critical: true,
                });
                return { success: false, error: error.message };
              }
            }

